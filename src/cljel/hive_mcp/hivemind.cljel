(ns hive-mcp.hivemind
  "Hivemind coordinator UI for swarm agents.

   Provides the Emacs UI for the hivemind coordinator:
   - Real-time agent status display
   - Notification popups for important events
   - Pending questions buffer with quick response
   - Agent activity log")

(require 'hive-mcp-channel)
(require 'hive-mcp-channel-ws)

;; Soft dependency on swarm hooks
(declare-function hive-mcp-swarm-hooks-dispatch "hive-mcp-swarm-hooks")

;;; Customization

(defgroup hive-mcp-hivemind nil
  "Hivemind coordinator for swarm agents."
  :group 'hive-mcp
  :prefix "hive-mcp-hivemind-")

(defcustom hive-mcp-hivemind-notify-events '(:hivemind-ask :hivemind-error :hivemind-blocked)
  "Event types that trigger desktop notifications."
  :type '(repeat symbol)
  :group 'hive-mcp-hivemind)

(defcustom hive-mcp-hivemind-log-buffer "*Hivemind Log*"
  "Buffer name for hivemind activity log."
  :type 'string
  :group 'hive-mcp-hivemind)

;;; State

(defvar hive-mcp-hivemind--agents (make-hash-table :test 'equal)
  "Hash table of agent-id -> status info.")

(defvar hive-mcp-hivemind--pending-asks nil
  "List of pending ask events awaiting response.")

;;; Internal Handlers

(defn- log [event-type agent-id message]
  "Log EVENT-TYPE from AGENT-ID with MESSAGE to the hivemind log buffer."
  (with-current-buffer (get-buffer-create hive-mcp-hivemind-log-buffer)
    (goto-char (point-max))
    (insert (format "[%s] %s (%s): %s\n"
                    (format-time-string "%H:%M:%S")
                    event-type
                    (or agent-id "unknown")
                    (or message "")))))

(defn- notify [agent-id event-type message]
  "Show desktop notification for EVENT-TYPE from AGENT-ID."
  (when (fboundp 'notifications-notify)
    (notifications-notify
     :title (format "Hivemind: %s" event-type)
     :body (format "[%s] %s" agent-id (or message ""))
     :urgency (if (string-match-p "ask\\|error\\|blocked"
                                  (downcase (or event-type "")))
                'critical
                'normal))))

(defn- handle-shout [event]
  "Handle a hivemind shout EVENT from an agent."
  (let [agent-id (or (alist-get 'agent-id event)
                     (cdr (assoc "agent-id" event)))
        data (or (alist-get 'data event)
                 (cdr (assoc "data" event)))
        event-type (or (alist-get 'type event)
                       (cdr (assoc "type" event)))
        timestamp (or (alist-get 'timestamp event)
                      (cdr (assoc "timestamp" event)))
        task (or (alist-get 'task data)
                 (cdr (assoc "task" data)))
        message (or (alist-get 'message data)
                    (cdr (assoc "message" data)))]
    ;; Update agent registry
    (puthash agent-id
             (list :status event-type
                   :task task
                   :message message
                   :last-seen (or timestamp (float-time)))
             hive-mcp-hivemind--agents)
    ;; Log the event
    (hive-mcp-hivemind--log event-type agent-id (or message task))
    ;; Notify if important
    (when (member (intern event-type) hive-mcp-hivemind-notify-events)
      (hive-mcp-hivemind--notify agent-id event-type message))
    ;; Dispatch to hooks for state sync
    (when (fboundp 'hive-mcp-swarm-hooks-dispatch)
      (hive-mcp-swarm-hooks-dispatch
       (intern (elisp-concat ":" event-type))
       (list :agent-id agent-id
             :event-type event-type
             :task task
             :message message
             :data data
             :timestamp (or timestamp (float-time)))))))

(defcustom hive-mcp-hivemind-ask-pop-up t
  "When non-nil, an ask that expects a typed answer shows its answer buffer
as soon as it arrives. Otherwise only a notification is shown; answer with
`hive-mcp-hivemind-respond'."
  :type 'boolean
  :group 'hive-mcp-hivemind)

(defn- field [event key]
  "Value of KEY, a string, in EVENT: an alist with symbol or string keys."
  (or (alist-get (intern key) event)
      (cdr (assoc key event))))

(defn- send-answer [ask-id answer]
  "Send ANSWER, any text, to pending ask ASK-ID and drop it from the list."
  (if (hive-mcp-channel-ws-connected-p)
    (hive-mcp-channel-ws-send
     (list (cons 'type "hivemind-response")
           (cons 'ask-id ask-id)
           (cons 'answer answer)
           (cons 'decision answer)
           (cons 'by "human")))
    ;; Fallback to old bencode channel
    (hive-mcp-channel-send
     (list (cons "type" "hivemind-response")
           (cons "ask-id" ask-id)
           (cons "answer" answer)
           (cons "decision" answer)
           (cons "by" "human"))))
  (setq hive-mcp-hivemind--pending-asks
        (seq-remove (lambda (a) (string= (plist-get a :ask-id) ask-id))
                    hive-mcp-hivemind--pending-asks))
  (message "Answered %s: %s" ask-id (truncate-string-to-width answer 60 nil nil "...")))

;;; Answer buffer

(defvar-local hive-mcp-hivemind--answer-ask nil
  "The ask this answer buffer replies to.")

(defvar-local hive-mcp-hivemind--answer-start nil
  "Marker where the typed answer begins.")

(defvar hive-mcp-hivemind-answer-mode-map (make-sparse-keymap)
  "Keymap for `hive-mcp-hivemind-answer-mode'.")

(define-key hive-mcp-hivemind-answer-mode-map (kbd "C-c C-c") 'hive-mcp-hivemind-answer-send)
(define-key hive-mcp-hivemind-answer-mode-map (kbd "C-c C-k") 'hive-mcp-hivemind-answer-cancel)

(define-derived-mode hive-mcp-hivemind-answer-mode text-mode "Hive-Answer"
  "Major mode for typing the answer to a hivemind ask.
The question and its context are read-only at the top; type below them.
\\<hive-mcp-hivemind-answer-mode-map>\\[hive-mcp-hivemind-answer-send] sends the answer, \\[hive-mcp-hivemind-answer-cancel] closes and leaves the ask pending.")

(defn- open-answer-buffer [ask]
  "Fill the answer buffer for ASK: question, context, suggested answers, then
an editable area. Returns the buffer without selecting it."
  (let [buf (get-buffer-create (format "*Hivemind Ask: %s*" (plist-get ask :agent-id)))]
    (with-current-buffer buf
      (let [inhibit-read-only t]
        (erase-buffer)
        (hive-mcp-hivemind-answer-mode)
        (insert (propertize (format "%s asks:\n" (plist-get ask :agent-id)) 'face 'bold))
        (insert (or (plist-get ask :question) "") "\n")
        (when (plist-get ask :context)
          (insert "\n" (propertize "Context\n" 'face 'bold) (plist-get ask :context) "\n"))
        (when (plist-get ask :options)
          (insert "\n" (propertize "Suggested answers: " 'face 'bold)
                  (mapconcat 'identity (plist-get ask :options) " | ") "\n"))
        (when (plist-get ask :cc)
          (insert (propertize "Also told the answer: " 'face 'shadow)
                  (mapconcat 'identity (plist-get ask :cc) ", ") "\n"))
        (insert "\n" (propertize "Type your answer below. C-c C-c sends, C-c C-k closes." 'face 'shadow)
                "\n" (make-string 60 45) "\n")
        (add-text-properties (point-min) (point)
                             '(read-only t front-sticky t rear-nonsticky t))
        (setq hive-mcp-hivemind--answer-ask ask)
        (setq hive-mcp-hivemind--answer-start (point-marker))))
    buf))

(defn answer-send []
  "Send the text typed in this buffer as the answer to its ask."
  (interactive)
  (let [ask hive-mcp-hivemind--answer-ask
        answer (string-trim (buffer-substring-no-properties
                             hive-mcp-hivemind--answer-start (point-max)))]
    (if (string-empty-p answer)
      (user-error "Type an answer first")
      (progn
        (hive-mcp-hivemind--send-answer (plist-get ask :ask-id) answer)
        (quit-window t)))))

(defn answer-cancel []
  "Close this answer buffer. The ask stays pending."
  (interactive)
  (quit-window t)
  (message "Ask left pending; M-x hive-mcp-hivemind-respond answers it later"))

;;; Incoming asks

(defn- handle-ask [event]
  "Handle a hivemind ask EVENT requiring human response.
The event may carry context and an expected answer kind (confirm, choice or
text); without one, options make it a choice and no options make it text."
  (let [options (append (hive-mcp-hivemind--field event "options") nil)
        ask (list :ask-id (hive-mcp-hivemind--field event "ask-id")
                  :agent-id (hive-mcp-hivemind--field event "agent-id")
                  :question (hive-mcp-hivemind--field event "question")
                  :context (hive-mcp-hivemind--field event "context")
                  :expects (or (hive-mcp-hivemind--field event "expects")
                               (if options "choice" "text"))
                  :options options
                  :cc (append (hive-mcp-hivemind--field event "cc") nil)
                  :timestamp (float-time))]
    ;; Store pending ask
    (push ask hive-mcp-hivemind--pending-asks)
    ;; Log it
    (hive-mcp-hivemind--log "ASK" (plist-get ask :agent-id) (plist-get ask :question))
    ;; Urgent notification
    (hive-mcp-hivemind--notify (plist-get ask :agent-id) "NEEDS INPUT" (plist-get ask :question))
    (if (and hive-mcp-hivemind-ask-pop-up
             (string= (plist-get ask :expects) "text"))
      (display-buffer (hive-mcp-hivemind--open-answer-buffer ask))
      (message "HIVEMIND ASK [%s]: %s (M-x hive-mcp-hivemind-respond)"
               (plist-get ask :agent-id) (plist-get ask :question)))))

;;; Public API

(defn status []
  "Show current hivemind status in a buffer."
  (interactive)
  (with-current-buffer (get-buffer-create "*Hivemind Status*")
    (erase-buffer)
    (insert "=== HIVEMIND STATUS ===\n\n")
    ;; Agents
    (insert "AGENTS:\n")
    (if (zerop (hash-table-count hive-mcp-hivemind--agents))
      (insert "  (no agents registered)\n")
      (maphash (lambda (id info)
                       (insert (format "  %s: %s - %s\n"
                                       id
                                       (plist-get info :status)
                                       (or (plist-get info :task) ""))))
               hive-mcp-hivemind--agents))
    ;; Pending asks
    (insert "\nPENDING QUESTIONS:\n")
    (if (null hive-mcp-hivemind--pending-asks)
      (insert "  (none)\n")
      (dolist (ask hive-mcp-hivemind--pending-asks)
              (insert (format "  [%s] %s (%s): %s\n"
                              (plist-get ask :ask-id)
                              (plist-get ask :agent-id)
                              (plist-get ask :expects)
                              (plist-get ask :question)))))
    (display-buffer (current-buffer))))

(defn- pick-ask [asks]
  "The ask to answer from ASKS: the only one, or one chosen by its question."
  (if (null asks)
    (user-error "No pending hivemind asks")
    (if (= 1 (length asks))
      (car asks)
      (let [labels (mapcar (lambda (a)
                                   (cons (format "[%s] %s" (plist-get a :agent-id) (plist-get a :question))
                                         a))
                           asks)
            label (completing-read "Answer which ask: " labels nil t)]
        (cdr (assoc label labels))))))

(defn respond [ask-id response]
  "Answer pending ASK-ID with RESPONSE, any text.
Interactively, pick the ask. One that expects typed text, or that carries
context, opens an answer buffer showing the context. A yes/no or choice ask
reads the answer in the minibuffer, where any typed text is also accepted."
  (interactive
   (let [ask (hive-mcp-hivemind--pick-ask hive-mcp-hivemind--pending-asks)]
     (if (or (string= (plist-get ask :expects) "text")
             (plist-get ask :context))
       (progn
         (pop-to-buffer (hive-mcp-hivemind--open-answer-buffer ask))
         (list nil nil))
       (list (plist-get ask :ask-id)
             (completing-read (format "%s: " (plist-get ask :question))
                              (plist-get ask :options))))))
  (when ask-id
    (hive-mcp-hivemind--send-answer ask-id response)))

(defn show-log []
  "Show the hivemind activity log."
  (interactive)
  (display-buffer (get-buffer-create hive-mcp-hivemind-log-buffer)))

(defn clear []
  "Clear hivemind state (for debugging)."
  (interactive)
  (clrhash hive-mcp-hivemind--agents)
  (setq hive-mcp-hivemind--pending-asks nil)
  (message "Hivemind state cleared"))

;;; Event Registration

(defn register-handlers []
  "Register hivemind event handlers with the channel."
  ;; WebSocket channel (primary)
  (dolist (type '("hivemind-progress" "hivemind-completed" "hivemind-error"
                                      "hivemind-blocked" "hivemind-started"))
          (hive-mcp-channel-ws-on type #'hive-mcp-hivemind--handle-shout))
  (hive-mcp-channel-ws-on "hivemind-ask" #'hive-mcp-hivemind--handle-ask)
  ;; Old bencode channel for backwards compatibility
  (dolist (type '(:hivemind-progress :hivemind-completed :hivemind-error
                                     :hivemind-blocked :hivemind-started))
          (hive-mcp-channel-on type #'hive-mcp-hivemind--handle-shout))
  (hive-mcp-channel-on :hivemind-ask #'hive-mcp-hivemind--handle-ask))

;; Register on load
(hive-mcp-hivemind-register-handlers)

(provide 'hive-mcp-hivemind)
