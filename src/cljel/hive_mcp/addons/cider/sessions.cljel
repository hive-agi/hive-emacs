(ns hive-mcp-cider-sessions
  "Named CIDER session registry and port allocation.")

(require 'cl-lib)

;; ============================================================================
;; Configuration
;; ============================================================================

(defcustom hive-mcp-cider-sessions-port-base 7920
  "Base port for spawning new CIDER sessions.
Sessions will use ports starting from this value."
  :type 'integer
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-sessions-port-max 7999
  "Maximum port for CIDER sessions."
  :type 'integer
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-sessions-port-claim-dir
  (expand-file-name "hive-mcp-cider-ports" temporary-file-directory)
  "Directory holding one claim link per reserved spawn port.
A claim is a symbolic link named after the port whose target is
\"PID:SESSION\". Creating a link is atomic, so two selections, in this Emacs
or in any other Emacs on the host, never claim the same port: a port is
reserved when it is selected, not only once its nREPL binds it."
  :type 'directory
  :group 'hive-mcp-cider)

;; ============================================================================
;; Registry State
;; ============================================================================

(defvar hive-mcp-cider-sessions--registry (make-hash-table :test 'equal)
  "Registry of named CIDER sessions.
Keys are session names (strings).
Values are plists with :port, :process, :buffer, :agent-id, :project-dir,
:repl-type, :status, :cider-buffer, :timer.")

(defvar hive-mcp-cider-sessions--claims (make-hash-table :test 'eql)
  "Port claims this Emacs holds: port -> session name.
The claim links in `hive-mcp-cider-sessions-port-claim-dir' are the shared
truth; this table is how this Emacs tells its own live claims from leftovers.")

;; ============================================================================
;; Port Claims (atomic, shared by every Emacs on the host)
;; ============================================================================

(defn claim-path [port]
  "Path of the claim link for PORT."
  (expand-file-name (number-to-string port) hive-mcp-cider-sessions-port-claim-dir))

(defn claim-owner-string [name]
  "Claim link target naming session NAME of this Emacs."
  (format "%d:%s" (emacs-pid) name))

(defn parse-claim-owner [target]
  "TARGET of a claim link, \"PID:NAME\", as (PID . NAME); nil when off-format. Pure."
  (when (stringp target)
    (let [i (string-match ":" target)]
      (when (and i (> i 0))
        (let [pid (string-to-number (substring target 0 i))]
          (when (> pid 0)
            (cons pid (substring target (+ i 1)))))))))

(defn pid-live-p [pid]
  "Non-nil when PID names a live process on this host."
  (and (integerp pid) (process-attributes pid) t))

(defn port-holding-p [props]
  "Non-nil when a session with PROPS still holds its :port.
Every session does, except a spawn that failed ('error) and whose nREPL
process is dead: nothing will bind its port again. Pure but for the process."
  (and (plist-get props :port)
       (not (and (eq (plist-get props :status) 'error)
                 (not (let [p (plist-get props :process)]
                        (and (processp p) (process-live-p p))))))
       t))

(defn claim-stale-p [owner port]
  "Non-nil when OWNER, the parsed claim link on PORT, no longer holds it.
An unreadable claim is stale, so is one whose PID is dead, and so is one of
this Emacs that its claim table does not record, or whose session now holds
another port or none."
  (elisp-cond
   ((null owner) t)
   ((not (pid-live-p (car owner))) t)
   ((= (car owner) (emacs-pid))
    (let [name (cdr owner)
          props (gethash name hive-mcp-cider-sessions--registry)]
      (or (not (equal name (gethash port hive-mcp-cider-sessions--claims)))
          (and props
               (plist-get props :port)
               (or (not (eql port (plist-get props :port)))
                   (not (port-holding-p props))))
          nil)))
   (t nil)))

(defn- -make-claim [path owner]
  "Create the claim link PATH -> OWNER atomically. t on success, nil when taken."
  (condition-case nil
      (progn (make-symbolic-link owner path) t)
    (file-already-exists nil)))

(defn- -take-over [path owner stale-target]
  "Replace the stale claim link PATH, last read as STALE-TARGET, by OWNER.
Two selections may judge the same claim stale; the takeover therefore runs
under PATH.takeover, itself an atomic link, and only while PATH still reads
STALE-TARGET, so exactly one of them wins. A mutex left by a dead process is
removed and the port skipped this round. t when OWNER now holds PATH."
  (let [mutex (format "%s.takeover" path)]
    (if (-make-claim mutex owner)
        (unwind-protect
            (when (equal stale-target (file-symlink-p path))
              (when stale-target (delete-file path))
              (-make-claim path owner))
          (ignore-errors (delete-file mutex)))
      (let [holder (parse-claim-owner (file-symlink-p mutex))]
        (when (or (null holder) (not (pid-live-p (car holder))))
          (ignore-errors (delete-file mutex)))
        nil))))

(defn claim-port [port name]
  "Atomically claim PORT for session NAME, against every Emacs on this host.
Returns non-nil when NAME holds PORT afterwards: the claim was created, NAME
already held it, or a stale claim was taken over. Returns nil when another
live session holds it. When the claim directory cannot be used at all, the
reservation degrades to this Emacs's registry, with a message, rather than
failing the spawn."
  (let [path (claim-path port)
        owner (claim-owner-string name)
        won (condition-case err
                (progn
                  (make-directory hive-mcp-cider-sessions-port-claim-dir t)
                  (or (-make-claim path owner)
                      (let* [target (file-symlink-p path)
                             held (parse-claim-owner target)]
                        (elisp-cond
                         ((and held (= (car held) (emacs-pid)) (equal (cdr held) name)) t)
                         ((claim-stale-p held port) (-take-over path owner target))
                         (t nil)))))
              (error
               (message "hive-mcp-cider: port claim %s unusable (%s); registry-only reservation"
                        path (error-message-string err))
               t))]
    (when won
      (puthash port name hive-mcp-cider-sessions--claims))
    won))

(defn release-port [port name]
  "Drop the claim on PORT when session NAME of this Emacs holds it.
Returns non-nil when a claim link was removed. Another owner's claim is left."
  (when (integerp port)
    (when (equal name (gethash port hive-mcp-cider-sessions--claims))
      (remhash port hive-mcp-cider-sessions--claims))
    (let [path (claim-path port)
          held (parse-claim-owner (file-symlink-p path))]
      (when (and held (= (car held) (emacs-pid)) (equal (cdr held) name))
        (condition-case nil
            (progn (delete-file path) t)
          (error nil))))))

;; ============================================================================
;; CRUD Operations
;; ============================================================================

(defn registry-has-name-p [name]
  "Return non-nil when NAME is present, including when its stored value is nil."
  (let [missing (make-symbol "missing-session")]
    (not (eq (gethash name hive-mcp-cider-sessions--registry missing)
             missing))))

(defn register [name props]
  "Register a session NAME with PROPS plist in the registry.
Signals error if NAME already exists."
  (unless (and name (stringp name))
    (error "Invalid session name: %S" name))
  (when (registry-has-name-p name)
    (error "Session '%s' already exists" name))
  (puthash name props hive-mcp-cider-sessions--registry)
  props)

(defn unregister [name]
  "Remove session NAME from the registry and release its port claim.
Returns the removed plist or nil."
  (let [session (gethash name hive-mcp-cider-sessions--registry)]
    (remhash name hive-mcp-cider-sessions--registry)
    (release-port (plist-get session :port) name)
    session))

(defn lookup [name]
  "Get session plist for NAME, or nil if not found."
  (gethash name hive-mcp-cider-sessions--registry))

(defn get-prop [name key]
  "Get property KEY from session NAME. Returns nil if session or key not found."
  (plist-get (gethash name hive-mcp-cider-sessions--registry) key))

(defn update-prop [name key value]
  "Set property KEY to VALUE in session NAME.
Signals error if session not found."
  (let [session (gethash name hive-mcp-cider-sessions--registry)]
    (unless session (error "Session '%s' not found" name))
    (puthash name (plist-put session key value)
             hive-mcp-cider-sessions--registry)
    value))

(defn update-props [name &rest kvs]
  "Set multiple properties in session NAME from key-value pairs.
Signals error if session not found."
  (let [session (gethash name hive-mcp-cider-sessions--registry)]
    (unless session (error "Session '%s' not found" name))
    (while kvs
      (setq session (plist-put session (car kvs) (cadr kvs)))
      (setq kvs (cddr kvs)))
    (puthash name session hive-mcp-cider-sessions--registry)
    session))

(defn exists-p [name]
  "Return non-nil if session NAME exists."
  (registry-has-name-p name))

;; ============================================================================
;; Query Operations
;; ============================================================================

(defn enum-label [value fallback]
  "Return FALLBACK for nil, symbol name for symbols, or VALUE unchanged."
  (elisp-cond
   ((null value) fallback)
   ((symbolp value) (symbol-name value))
   (t value)))

(defn list-all []
  "Return a vector of session info plists for JSON encoding.
Each entry contains :name, :port, :repl-type, :status, :reason, :agent-id,
:project-dir, :cider-buffer. :project-dir lets callers match a session to
its project for scoped reuse; :reason carries why a failed session failed."
  (let [sessions '()]
    (maphash (lambda (name props)
               (when (stringp name)
                 (let [status (plist-get props :status)
                       rtype (plist-get props :repl-type)]
                   (push (list :name name
                               :port (plist-get props :port)
                               :repl-type (enum-label rtype "clj")
                               :status (enum-label status "unknown")
                               :reason (plist-get props :reason)
                               :agent-id (plist-get props :agent-id)
                               :project-dir (plist-get props :project-dir)
                               :cider-buffer (plist-get props :cider-buffer))
                         sessions))))
             hive-mcp-cider-sessions--registry)
    (vconcat sessions)))

(defn find-by-status [status]
  "Find first session name with STATUS (symbol). Returns name string or nil."
  (let [result nil]
    (maphash (lambda (name props)
               (when (and (stringp name)
                          (not result)
                          (eq (plist-get props :status) status))
                 (setq result name)))
             hive-mcp-cider-sessions--registry)
    result))

(defn find-by-buffer [buffer-name]
  "Find the session that owns BUFFER-NAME as its :cider-buffer.
Returns the session name string, or nil when no session claims BUFFER-NAME."
  (let [result nil]
    (maphash (lambda (name props)
               (when (and (stringp name)
                          (not result)
                          (equal (plist-get props :cider-buffer) buffer-name))
                 (setq result name)))
             hive-mcp-cider-sessions--registry)
    result))

;; ============================================================================
;; Liveness Reconciliation
;; ============================================================================

(defn stale-p [status alive-p]
  "Return non-nil when a session declaring STATUS with liveness ALIVE-P is lying.
A session is stale exactly when it claims 'connected while its REPL is not live.
Pure decision function — no registry or CIDER access."
  (and (eq status 'connected) (not alive-p)))

(defn reconcile [alive-fn]
  "Demote every session whose 'connected claim is contradicted by reality.
ALIVE-FN is a predicate (NAME) -> non-nil when that session's REPL is live;
injecting it keeps this registry free of any CIDER dependency.
Returns the list of names demoted to 'stale."
  (let [demoted '()]
    (maphash (lambda (name props)
               (when (and (stringp name)
                          (stale-p (plist-get props :status)
                                   (funcall alive-fn name)))
                 (push name demoted)))
             hive-mcp-cider-sessions--registry)
    (dolist (name demoted)
      (update-prop name :status 'stale))
    demoted))

(defn promotable-p [status alive-p]
  "Return non-nil when a session declaring STATUS with liveness ALIVE-P settled unrecorded.
A session still claiming 'connecting while its REPL is live is connected. Pure."
  (and (eq status 'connecting) alive-p t))

(defn promote [alive-fn]
  "Promote every 'connecting session whose REPL is live to 'connected.
ALIVE-FN is a predicate (NAME) -> non-nil when that session's REPL is live and
fully settled. Returns the list of promoted names."
  (let [promoted '()]
    (maphash (lambda (name props)
               (when (and (stringp name)
                          (promotable-p (plist-get props :status)
                                        (funcall alive-fn name)))
                 (push name promoted)))
             hive-mcp-cider-sessions--registry)
    (dolist (name promoted)
      (update-props name :status 'connected :reason nil))
    promoted))

(defn clear-all []
  "Remove all sessions from registry, releasing every port claim they hold."
  (maphash (lambda (name props)
             (release-port (plist-get props :port) name))
           hive-mcp-cider-sessions--registry)
  (clrhash hive-mcp-cider-sessions--registry))

(defn count-sessions []
  "Return the number of registered sessions."
  (hash-table-count hive-mcp-cider-sessions--registry))

(defn names []
  "Return list of all session names."
  (hash-table-keys hive-mcp-cider-sessions--registry))

;; ============================================================================
;; Port Allocation
;; ============================================================================

(defn held-ports [&optional except-name]
  "Ports held by registered sessions (see `port-holding-p'), other than
EXCEPT-NAME's."
  (let [ports '()]
    (maphash (lambda (name props)
               (when (and (not (equal name except-name))
                          (port-holding-p props))
                 (push (plist-get props :port) ports)))
             hive-mcp-cider-sessions--registry)
    ports))

(defn find-available-port [port-check-fn &optional name]
  "Find next available port in the session range.
PORT-CHECK-FN is a predicate (port) -> bool that returns t if port is in use.
A port a registered session holds is skipped without probing. With NAME, the
returned port is also atomically claimed for session NAME (`claim-port'), so
no other selection, in this Emacs or another, is handed it until released."
  (let [port hive-mcp-cider-sessions-port-base
        used-ports (held-ports)]
    (while (and (<= port hive-mcp-cider-sessions-port-max)
                (or (member port used-ports)
                    (funcall port-check-fn port)
                    (and name (not (claim-port port name)))))
      (setq port (+ port 1)))
    (if (<= port hive-mcp-cider-sessions-port-max)
        port
      (error "No available ports in range %d-%d"
             hive-mcp-cider-sessions-port-base
             hive-mcp-cider-sessions-port-max))))

(defn reserve-port [name port-check-fn &optional requested]
  "Select and claim a port for session NAME; return it.
REQUESTED is used when no other registered session holds it, PORT-CHECK-FN
finds it free and the claim succeeds; otherwise, and with no REQUESTED, the
next free port of the range is claimed (`find-available-port'). The claim is
released by `release-port', `unregister' or `clear-all'."
  (if (and (integerp requested)
           (not (member requested (held-ports name)))
           (not (funcall port-check-fn requested))
           (claim-port requested name))
      requested
    (find-available-port port-check-fn name)))

;; ============================================================================
;; Session Construction Helpers
;; ============================================================================

(defn make-session [port &rest kvs]
  "Create a session plist with PORT and optional KVS overrides.
Defaults: :process nil, :buffer nil, :agent-id nil, :project-dir nil,
:repl-type 'clj, :status 'starting, :cider-buffer nil, :timer nil."
  (let [session (list :port port
                      :process nil :buffer nil
                      :agent-id nil :project-dir nil
                      :repl-type 'clj
                      :status 'starting
                      :cider-buffer nil :timer nil)]
    (while kvs
      (setq session (plist-put session (car kvs) (cadr kvs)))
      (setq kvs (cddr kvs)))
    session))
