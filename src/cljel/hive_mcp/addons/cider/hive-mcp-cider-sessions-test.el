(defun hive-mcp-cider-sessions-test--claim-child-form (claims base max name go)
  "Elisp a child Emacs evaluates: claim a port as NAME, print it, hold it until GO exists."
  (format "(progn (require 'hive-mcp-cider-sessions) (setq hive-mcp-cider-sessions-port-claim-dir %S hive-mcp-cider-sessions-port-base %d hive-mcp-cider-sessions-port-max %d) (princ (format \"PORT=%%d\\n\" (hive-mcp-cider-sessions-reserve-port %S (lambda (_p) nil) %d))) (let ((deadline (+ (float-time) 60))) (while (and (not (file-exists-p %S)) (< (float-time) deadline)) (sleep-for 0.05))))" claims base max name base go))

(ert-deftest hive-mcp-cider-sessions-test-parallel-processes-distinct nil "N Emacs processes selecting at the same time, all requesting the same port\nbefore anything binds it, are handed N distinct ports: the claim is atomic\nacross processes, not only within one registry." (let* ((claims (make-temp-file "hive-mcp-cider-claims" t))
        (go (expand-file-name "go" claims))
        (libdir (file-name-directory (locate-library "hive-mcp-cider-sessions")))
        (emacs-bin (expand-file-name invocation-name invocation-directory))
        (n 6)
        (procs '()))
    (unwind-protect
    (progn
  (cl-dotimes (i n)
    (push (make-process :name (format "claim-child-%d" i) :buffer (generate-new-buffer (format " *claim-child-%d*" i)) :command (list emacs-bin "-Q" "--batch" "-L" libdir "--eval" (hive-mcp-cider-sessions-test--claim-child-form claims 7960 7979 (format "child-%d" i) go)) :noquery t) procs))
  (let* ((deadline (+ (float-time) 90))
        (printed (lambda (p)
    (with-current-buffer (process-buffer p)
    (save-excursion
    (goto-char (point-min))
    (when (re-search-forward "PORT=\\([0-9]+\\)" nil t)
    (string-to-number (match-string 1))))))))
    (while (and (< (float-time) deadline) (not (cl-every printed procs)) (cl-some #'process-live-p procs))
    (accept-process-output nil 0.1))
    (let* ((ports (mapcar printed procs)))
    (should (cl-every #'integerp ports))
    (should (equal n (length (delete-dups (copy-sequence ports)))))
    (should (cl-every (lambda (p)
    (and (<= 7960 p) (<= p 7979))) ports)))))
  (write-region "" nil go nil 'silent)
  (dolist (p procs)
    (let* ((deadline (+ (float-time) 10)))
    (while (and (process-live-p p) (< (float-time) deadline))
    (accept-process-output nil 0.05)))
    (when (process-live-p p)
    (delete-process p))
    (when (buffer-live-p (process-buffer p))
    (kill-buffer (process-buffer p))))
  (delete-directory claims t))))

