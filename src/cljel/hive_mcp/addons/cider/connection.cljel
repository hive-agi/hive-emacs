(ns hive-mcp-cider-connection
  "CIDER connection orchestration and auto-connect logic.

Handles the lifecycle of connecting CIDER to nREPL servers:
- Synchronous CLJ connections
- Deferred CLJS/CLJEL connections (timer + accept-process-output polling)
- Auto-connect polling for spawned sessions
- Cascading ensure-connected strategy

Design principles (SOLID/CLARITY):
- Single Responsibility: Only orchestrates CIDER connections
- Dependency Inversion: Uses sessions registry and nrepl port-check via function refs
- FP: Closure-local mutable cells for async state (no global defvars)")

(require 'cl-lib)
;; string-trim, used to normalize sentinel events and process output lines.
(require 'subr-x)

;; Dependencies on sibling modules
(declare-function hive-mcp-cider-sessions-lookup "hive-mcp-cider-sessions")
(declare-function hive-mcp-cider-sessions-get-prop "hive-mcp-cider-sessions")
(declare-function hive-mcp-cider-sessions-update-prop "hive-mcp-cider-sessions")
(declare-function hive-mcp-cider-sessions-update-props "hive-mcp-cider-sessions")
(declare-function hive-mcp-cider-sessions-find-by-status "hive-mcp-cider-sessions")
(declare-function hive-mcp-cider-sessions-find-by-buffer "hive-mcp-cider-sessions")
(declare-function hive-mcp-cider-sessions-exists-p "hive-mcp-cider-sessions")
(declare-function hive-mcp-cider-sessions-reconcile "hive-mcp-cider-sessions")
(declare-function hive-mcp-cider-sessions-register "hive-mcp-cider-sessions")
(declare-function hive-mcp-cider-sessions-make-session "hive-mcp-cider-sessions")
(declare-function hive-mcp-cider-nrepl-port-open-p "hive-mcp-cider-nrepl")
(declare-function hive-mcp-cider-nrepl-project-dir "hive-mcp-cider-nrepl")

;; Dependencies on CIDER
(declare-function cider-connect-clj "cider")
(declare-function cider-connect-cljs "cider")
(declare-function cider-connected-p "cider-connection")
(declare-function cider-nrepl-request:eval "cider-client")
(declare-function cider-make-connection-default "cider-connection")
(declare-function cider-cljel-start "cider-clojure-elisp")
(declare-function nrepl-dict-get "nrepl-dict")

;; Cross-module state references
(defvar hive-mcp-cider-sessions--registry)
(defvar hive-mcp-cider-nrepl-port)
(defvar hive-mcp-cider-nrepl-shadow-build)

;; Buffer-local flag owned by cider-clojure-elisp; the only honest signal that a
;; cljel compilation session actually came up on a connection.
(defvar cider-cljel-active)

;; ============================================================================
;; Configuration
;; ============================================================================

(defcustom hive-mcp-cider-connection-auto-connect t
  "When non-nil, automatically connect CIDER when nREPL is available."
  :type 'boolean
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-connection-retry-interval 1.0
  "Seconds between connection retry attempts."
  :type 'number
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-connection-max-retries 30
  "Maximum number of connection retry attempts (0 = unlimited)."
  :type 'integer
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-connection-cljs-repl-type "shadow"
  "ClojureScript REPL type for cider-connect-cljs."
  :type '(choice (const "shadow") (const "figwheel") (const "browser"))
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-connection-deferred-timeout 15
  "Timeout in seconds for deferred (non-blocking) CIDER connections."
  :type 'integer
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-connection-handshake-timeout 20
  "Seconds to wait for the nREPL handshake after a socket connect.
A connection counts as ready only when `cider-connected-p' holds in its
REPL buffer — an open TCP port is not readiness."
  :type 'number
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-connection-readiness-interval 0.3
  "Seconds between readiness polls while waiting for a handshake or upgrade."
  :type 'number
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-connection-upgrade-timeout 15
  "Seconds to wait for a cljs/cljel REPL upgrade to confirm itself."
  :type 'number
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-connection-spawn-initial-delay 2.0
  "Seconds before the first connect attempt against a freshly spawned session."
  :type 'number
  :group 'hive-mcp-cider)

;; ============================================================================
;; Internal State (auto-connect only)
;; ============================================================================

(defvar hive-mcp-cider-connection--auto-timer nil
  "Timer for auto-connect retry attempts.")

(defvar hive-mcp-cider-connection--auto-attempts 0
  "Number of auto-connect attempts made.")

;; ============================================================================
;; Pure Decisions (no CIDER, no registry — directly testable)
;; ============================================================================

(defn retry-exhausted-p [attempts max-retries]
  "Return non-nil when ATTEMPTS has reached the MAX-RETRIES cap.
A MAX-RETRIES of 0 (or a non-integer) means unlimited, matching
`hive-mcp-cider-connection-max-retries' semantics on the auto-connect path."
  (and (integerp max-retries)
       (> max-retries 0)
       (>= attempts max-retries)))

(defn settled-props [buffer-name repl-type]
  "Registry props for a connection of REPL-TYPE that completed its handshake
in BUFFER-NAME."
  (list :status 'connected :repl-type repl-type :cider-buffer buffer-name))

(defn handshake-failed-props [port reason]
  "Registry props for a connection whose nREPL handshake never completed on PORT.
REASON is the surfaced human-readable failure cause."
  (list :status 'error
        :reason (format "port %d: %s" port reason)))

(defn cljel-upgrade-props [buffer-name upgraded-p]
  "Registry props for a cljel target in BUFFER-NAME once its upgrade settled.
A confirmed upgrade keeps :repl-type 'cljel; an unconfirmed one is recorded as
the plain clj connection it actually is, so no caller routes cljel code at it."
  (if upgraded-p
      (list :status 'connected :repl-type 'cljel
            :cider-buffer buffer-name :cljel-upgrade 'confirmed)
    (list :status 'connected :repl-type 'clj
          :cider-buffer buffer-name :cljel-upgrade 'failed)))

(defn settle-budget [repl-type]
  "Total seconds a REPL-TYPE connection is allowed to take to settle.
Deferred dispatch plus the handshake, plus the upgrade budget when REPL-TYPE
needs one."
  (+ hive-mcp-cider-connection-deferred-timeout
     hive-mcp-cider-connection-handshake-timeout
     (if (memq repl-type '(cljs cljel))
         hive-mcp-cider-connection-upgrade-timeout
       0)))

(defn spawn-death-reason [exit-desc tail]
  "Explain a spawn whose nREPL process died before its port ever opened.
EXIT-DESC is the trimmed process sentinel event; TAIL is the last of the
process buffer's output, or nil. Pure."
  (if (and tail (not (string= "" tail)))
      (format "nREPL process %s; last output: %s" exit-desc tail)
    (format "nREPL process %s before opening its port (no output)" exit-desc)))

(defn unsettled-status-p [status]
  "Return non-nil when STATUS means a spawned session never reached a REPL.
These are the states a dying nREPL process may still fail out of; a session
already 'connected (or explicitly reaped) is not the sentinel's business."
  (memq status '(starting connecting)))

(defn connectivity-failure-reason [port port-open-p]
  "Explain why no usable CIDER connection exists on PORT.
PORT-OPEN-P is whether the nREPL socket accepted a connection."
  (if port-open-p
      (format "nREPL on port %d never completed the CIDER handshake" port)
    (format "no live REPL on port %d" port)))

;; ============================================================================
;; Readiness Probes
;; ============================================================================

(defn- -connection-ready-p [conn]
  "Return non-nil when CONN is a live buffer whose nREPL handshake completed."
  (and (buffer-live-p conn)
       (with-current-buffer conn
         (and (fboundp 'cider-connected-p) (cider-connected-p)))))

(defn- -cljel-ready-p [conn]
  "Return non-nil when CONN's CLJEL compilation session is confirmed active."
  (and (buffer-live-p conn)
       (with-current-buffer conn
         (and (bound-and-true-p cider-cljel-active) t))))

(defn- -poll-async [pred timeout interval on-done]
  "Call ON-DONE with t as soon as PRED holds, or with nil after TIMEOUT seconds.
Re-arms itself every INTERVAL seconds via `run-at-time' and returns immediately,
so timer callbacks never block the Emacs event loop."
  (let [deadline (+ (float-time) timeout)
        cell (list nil)]
    (setcar cell
            (lambda ()
              (elisp-cond
               ((funcall pred) (funcall on-done t))
               ((> (float-time) deadline) (funcall on-done nil))
               (t (run-at-time interval nil (car cell))))))
    (funcall (car cell))))

(defn- -wait-for [pred timeout]
  "Block until PRED holds or TIMEOUT seconds elapse; return t or nil.
Pumps the event loop with `accept-process-output' so async CIDER callbacks
still run. For synchronous callers only — timers must use `-poll-async'."
  (let [deadline (+ (float-time) timeout)]
    (while (and (not (funcall pred)) (< (float-time) deadline))
      (accept-process-output nil hive-mcp-cider-connection-readiness-interval))
    (and (funcall pred) t)))

(defn- -settle [on-settled props]
  "Deliver PROPS to the optional ON-SETTLED callback."
  (when on-settled (funcall on-settled props)))

;; ============================================================================
;; CIDER Connection Dispatch
;; ============================================================================

(defn- -connect-clj-no-prompt [port &optional project-dir]
  "Connect CIDER CLJ to PORT, suppressing the duplicate session prompt.
CIDER's y-or-n-p blocks forever in non-interactive (emacsclient) contexts.
PROJECT-DIR (optional) is passed to cider-connect-clj so the resulting
REPL buffer is labeled with the target project. Without it, CIDER infers
the project from the calling buffer's default-directory, which defaults
to whatever Emacs buffer happens to be current when the timer fires —
typically wrong when the spawn was triggered by an MCP tool call."
  (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
    (let [args (list :host "localhost" :port port)]
      (cider-connect-clj
        (if project-dir
            (append args (list :project-dir project-dir))
          args)))))

(defn- -settle-once [cell on-settled props]
  "Deliver PROPS to ON-SETTLED only the first time CELL is claimed."
  (unless (car cell)
    (setcar cell t)
    (-settle on-settled props)))

(defn- -upgrade-cljs [conn old-name port on-settled]
  "Select the shadow-cljs build on the ready connection CONN, then settle.
OLD-NAME is CONN's buffer name at connect time, used to repoint exactly the
session that owns it once CIDER renames the buffer. PORT only labels failures."
  (let [done (list nil)
        select-form (format "(do (require '[shadow.cljs.devtools.api :as shadow]) (shadow/nrepl-select %s))"
                            hive-mcp-cider-nrepl-shadow-build)]
    (with-current-buffer conn
      (cider-nrepl-request:eval
       select-form
       (lambda (response)
         (when (member "done" (nrepl-dict-get response "status"))
           (run-at-time hive-mcp-cider-connection-readiness-interval nil
                        (lambda ()
                          (-update-session-buffer-name conn old-name)
                          (-settle-once done on-settled
                                        (settled-props (buffer-name conn) 'cljs))))))))
    (run-at-time hive-mcp-cider-connection-upgrade-timeout nil
                 (lambda ()
                   (-settle-once done on-settled
                                 (handshake-failed-props
                                  port "shadow-cljs build never selected"))))))

(defn- -upgrade-cljel [conn port on-settled]
  "Start the CLJEL compilation session on the ready connection CONN and verify it.
Settles with 'cljel only once `cider-cljel-active' is confirmed in CONN;
an unconfirmed upgrade settles as the plain clj connection it really is.
PORT only labels failures."
  (if (not (fboundp 'cider-cljel-start))
      (progn
        (message "hive-mcp-cider: cider-cljel-start unavailable on port %d — staying clj" port)
        (-settle on-settled (cljel-upgrade-props (buffer-name conn) nil)))
    (with-current-buffer conn
      (cider-cljel-start))
    (-poll-async (lambda () (-cljel-ready-p conn))
                 hive-mcp-cider-connection-upgrade-timeout
                 hive-mcp-cider-connection-readiness-interval
                 (lambda (upgraded)
                   (unless upgraded
                     (message "hive-mcp-cider: cljel upgrade unconfirmed on port %d — recording session as clj" port))
                   (-settle on-settled
                            (cljel-upgrade-props (buffer-name conn) upgraded))))))

(defn connect-by-repl-type [repl-type port &optional project-dir on-settled]
  "Connect CIDER to nREPL on PORT using the appropriate method for REPL-TYPE.
Returns the connection buffer immediately.

ON-SETTLED (optional) is called exactly once with a registry props plist
describing how the connection actually settled — never at socket-open time.
It fires only after the nREPL handshake completes (`cider-connected-p' in the
REPL buffer) and, for cljs/cljel, after the REPL upgrade has been confirmed or
timed out. Failure props carry :status 'error and a :reason string.

For cljs and cljel, connects as CLJ first and upgrades once ready.
PROJECT-DIR (optional) is threaded to cider-connect-clj so the REPL
buffer is labeled with the target project rather than whatever buffer
is current at connect time."
  (let* [conn (-connect-clj-no-prompt port project-dir)
         old-name (buffer-name conn)
         ready-p (lambda () (-connection-ready-p conn))
         on-handshake
         (lambda (ready)
           (if (not ready)
               (-settle on-settled
                        (handshake-failed-props
                         port "nREPL handshake did not complete"))
             (pcase repl-type
               ('cljs (-upgrade-cljs conn old-name port on-settled))
               ('cljel (-upgrade-cljel conn port on-settled))
               ('cljw (-settle on-settled (settled-props (buffer-name conn) 'cljw)))
               ('cljrs (-settle on-settled (settled-props (buffer-name conn) 'cljrs)))
               (_ (-settle on-settled
                           (settled-props (buffer-name conn) 'clj))))))]
    (-poll-async ready-p
                 hive-mcp-cider-connection-handshake-timeout
                 hive-mcp-cider-connection-readiness-interval
                 on-handshake)
    conn))

;; ============================================================================
;; Deferred Connection (non-blocking for emacsclient)
;; ============================================================================

(defn connect-deferred [repl-type port &optional project-dir]
  "Connect CIDER to nREPL on PORT without blocking emacsclient, and wait for
the connection to SETTLE — handshake complete, upgrade confirmed or ruled out.

Returns a plist (:buffer CONN :props SETTLED-PROPS); SETTLED-PROPS is the
registry props `connect-by-repl-type' produced, so a caller can never report
\"connected\" ahead of the real connection. Signals an error when the connect
call itself fails or nothing settles within `settle-budget'.
PROJECT-DIR (optional) labels the REPL buffer with the target project.

Uses closure-local mutable cells instead of global defvars."
  (let [cell (cons nil nil)      ;; (buffer-or-error . dispatched-p)
        settled (list nil)]      ;; (props)
    ;; Defer to Emacs event loop
    (run-at-time 0 nil
                 (lambda ()
                   (condition-case err
                       (progn
                         (setcar cell
                                 (connect-by-repl-type
                                  repl-type port project-dir
                                  (lambda (props) (setcar settled props))))
                         (setcdr cell t))
                     (error
                      (setcar cell err)
                      (setcdr cell 'error)))))
    ;; Poll until settled or budget exhausted
    (let [timeout (settle-budget repl-type)]
      (-wait-for (lambda () (or (eq (cdr cell) 'error) (car settled))) timeout)
      (elisp-cond
       ((eq (cdr cell) 'error)
        (error "Connect failed: %s" (error-message-string (car cell))))
       ((not (car settled))
        (error "Connect did not settle within %s seconds on port %d"
               timeout port))
       (t (list :buffer (car cell) :props (car settled)))))))

;; ============================================================================
;; Session Connection Helpers
;; ============================================================================

(defn- -update-session-buffer-name [conn old-name]
  "Repoint the one session that owns OLD-NAME at CONN's current buffer name.
CONN is the original connection buffer object; OLD-NAME is the buffer name it
carried at connect time. Only the owning session is touched — a coexisting
session whose own :cider-buffer happens to be dead is left alone."
  (let [new-name (when (buffer-live-p conn) (buffer-name conn))]
    (when (and new-name old-name (not (string= old-name new-name)))
      (when-let* [target (hive-mcp-cider-sessions-find-by-buffer old-name)]
        (hive-mcp-cider-sessions-update-prop target :cider-buffer new-name)
        (message "hive-mcp-cider: Session '%s' buffer updated to %s" target new-name)))))

(defn- -cancel-session-timer [name]
  "Cancel the auto-connect timer for session NAME."
  (when-let* [session (hive-mcp-cider-sessions-lookup name)
              timer (plist-get session :timer)]
    (when (timerp timer)
      (cancel-timer timer))
    (hive-mcp-cider-sessions-update-prop name :timer nil)))

(defn- -apply-settled-props [name props]
  "Write settled connection PROPS onto session NAME, if it still exists.
Surfaces the settled status (and any :reason) so a failed handshake or an
unconfirmed REPL upgrade is visible instead of silent."
  (when (hive-mcp-cider-sessions-exists-p name)
    (apply #'hive-mcp-cider-sessions-update-props name props)
    (let [reason (plist-get props :reason)]
      (message "hive-mcp-cider: Session '%s' settled as %s (%s)%s"
               name
               (symbol-name (or (plist-get props :status) 'unknown))
               (symbol-name (or (plist-get props :repl-type) 'clj))
               (if reason (format " — %s" reason) "")))))

(defn- -process-output-tail [buffer-name max-lines]
  "Return the last MAX-LINES non-blank lines of BUFFER-NAME as one string.
Nil when the buffer is gone or produced nothing."
  (when-let* [buf (get-buffer buffer-name)]
    (with-current-buffer buf
      (let* [text (buffer-substring-no-properties (point-min) (point-max))
             lines (delq nil (mapcar (lambda (l)
                                       (let [s (string-trim l)]
                                         (unless (string= "" s) s)))
                                     (split-string text "\n")))
             start (max 0 (- (length lines) max-lines))
             tail (cl-subseq lines start)]
        (when tail (mapconcat #'identity tail " | "))))))

(defn watch-spawn-process [name process]
  "Fail session NAME fast if PROCESS dies before its nREPL port opens.

Without this the retry timer polls a port that nobody will ever open and
reports a 30-attempt timeout, hiding the real cause — a bad classpath, a
missing alias, or an alias whose :main-opts hijacked the -m. The sentinel
cancels the timer and records 'error with the process's own last output as
:reason. A session that already settled 'connected is left alone."
  (when (processp process)
    (set-process-sentinel
      process
      (lambda (proc event)
        (when (not (process-live-p proc))
          (let [status (and (hive-mcp-cider-sessions-exists-p name)
                            (hive-mcp-cider-sessions-get-prop name :status))]
            (when (unsettled-status-p status)
              (let [reason (spawn-death-reason
                             (string-trim (or event "exited"))
                             (-process-output-tail (format "*nREPL-%s*" name) 4))]
                (-cancel-session-timer name)
                (hive-mcp-cider-sessions-update-props name
                  :status 'error
                  :reason reason)
                (message "hive-mcp-cider: Session '%s' spawn failed — %s"
                         name reason)))))))))

(defn try-connect-session [name]
  "Try to connect CIDER to session NAME.
Called by timer for spawned sessions. Dispatches based on :repl-type.
Binds default-directory to the session's :project-dir so CIDER labels
the REPL buffer with the correct project root (not the current buffer's dir).

Switches to *scratch* before invoking cider-connect — timer callbacks
fire with unpredictable current-buffer (could be *Messages* — read-only,
or a killed buffer). CIDER's `cider--gather-connect-params` inspects
current-buffer for `nrepl-endpoint`; firing from a non-REPL/non-server
buffer that the gather call walks into raises 'not a REPL or SERVER
buffer'. *scratch* is always alive, fundamental-mode, and
write-friendly — a stable evaluation context for the connect.

An open socket only moves the session to 'connecting; the settle callback
from `connect-by-repl-type' is what writes 'connected (or 'error, with a
:reason) once the nREPL handshake and any REPL upgrade have resolved.
The no-socket-yet branch is capped by `hive-mcp-cider-connection-max-retries'
(0 = unlimited)."
  (let* [session (hive-mcp-cider-sessions-lookup name)
         port (plist-get session :port)
         status (plist-get session :status)
         repl-type (or (plist-get session :repl-type) 'clj)
         proj-dir (plist-get session :project-dir)]
    (when (and session (eq status 'starting))
      (if (hive-mcp-cider-nrepl-port-open-p port)
          (condition-case err
              (let* [expanded-dir (and proj-dir (file-name-as-directory
                                                  (expand-file-name proj-dir)))
                     scratch (or (get-buffer "*scratch*")
                                 (get-buffer-create "*scratch*"))
                     settle (lambda (props) (-apply-settled-props name props))
                     conn (with-current-buffer scratch
                            (let [default-directory (or expanded-dir default-directory)]
                              (connect-by-repl-type repl-type port expanded-dir settle)))]
                (-cancel-session-timer name)
                (hive-mcp-cider-sessions-update-prop name :cider-buffer (buffer-name conn))
                (when (eq (hive-mcp-cider-sessions-get-prop name :status) 'starting)
                  (hive-mcp-cider-sessions-update-prop name :status 'connecting)
                  (message "hive-mcp-cider: Session '%s' (%s) socket open on port %d, awaiting nREPL handshake"
                           name (symbol-name repl-type) port)))
            (error
             (-cancel-session-timer name)
             (hive-mcp-cider-sessions-update-props name
               :status 'error
               :reason (error-message-string err))
             (message "hive-mcp-cider: Session '%s' connection failed: %s"
                      name (error-message-string err))))
        (let [attempts (1+ (or (plist-get session :attempts) 0))]
          (if (not (retry-exhausted-p attempts hive-mcp-cider-connection-max-retries))
              (hive-mcp-cider-sessions-update-prop name :attempts attempts)
            (-cancel-session-timer name)
            (hive-mcp-cider-sessions-update-props name
              :attempts attempts
              :status 'timeout
              :reason (connectivity-failure-reason port nil))
            (message "hive-mcp-cider: Session '%s' timed out after %d attempts waiting for nREPL"
                     name attempts)))))))

;; ============================================================================
;; Ensure Connected (cascading strategy)
;; ============================================================================

(defn- -session-buffer-alive-p [name]
  "Return non-nil if session NAME's :cider-buffer is a live buffer
with an active CIDER connection. Stale registry entries (buffer killed,
nREPL died, or CIDER detached) return nil so callers can evict them."
  (let* [cider-buf (hive-mcp-cider-sessions-get-prop name :cider-buffer)
         buf (and cider-buf (get-buffer cider-buf))]
    (and buf (-connection-ready-p buf) t)))

(defn- -evict-stale-session [name]
  "Demote session NAME to :status 'stale so it stops being returned by
find-by-status lookups. Caller is the one that detected the dead buffer."
  (message "hive-mcp-cider: Evicting stale session '%s' (cider buffer dead)" name)
  (hive-mcp-cider-sessions-update-prop name :status 'stale))

(defn- -find-live-connected-session []
  "Find first registry session whose :status is 'connected AND whose
CIDER buffer is actually live. Demotes stale entries (status says
connected but buffer is dead) so they stop poisoning the lookup.
Returns session name string or nil."
  (let [candidate (hive-mcp-cider-sessions-find-by-status 'connected)]
    (elisp-cond
     ((null candidate) nil)
     ((-session-buffer-alive-p candidate) candidate)
     (t
      (-evict-stale-session candidate)
      (-find-live-connected-session)))))

(defn- -switch-to-session [name]
  "Switch to session NAME, making it the default CIDER connection.
Returns t on success, nil if the cider buffer is dead or
cider-make-connection-default is unavailable. Evicts NAME from the
registry on a dead-buffer cache miss."
  (let* [cider-buf (hive-mcp-cider-sessions-get-prop name :cider-buffer)
         buf (and cider-buf (get-buffer cider-buf))]
    (elisp-cond
     ((not (and buf (buffer-live-p buf)))
      (when cider-buf (-evict-stale-session name))
      nil)
     ((not (fboundp 'cider-make-connection-default))
      nil)
     (t
      (with-current-buffer buf
        (cider-make-connection-default (current-buffer)))
      t))))

(defn reconcile-sessions []
  "Reconcile every registered session's :status against real REPL liveness.
Any session claiming 'connected whose CIDER buffer is dead is reaped down to
'stale, so a dead session can never be reported as connected.
Returns the list of demoted session names."
  (hive-mcp-cider-sessions-reconcile #'-session-buffer-alive-p))

(defn describe-connectivity []
  "Return a one-line diagnosis of why no CIDER connection is available.
Distinguishes a closed nREPL socket from one that never handshook."
  (connectivity-failure-reason
   hive-mcp-cider-nrepl-port
   (hive-mcp-cider-nrepl-port-open-p hive-mcp-cider-nrepl-port)))

(defn ensure-connected []
  "Ensure CIDER is connected, reusing existing session or auto-connecting.
Returns t only once CIDER is actually connected, nil otherwise.
Priority: 1) Already connected 2) Reuse live registry session 3) Connect to default port.
Stale registry sessions (status 'connected but buffer dead) are demoted
to 'stale so they stop short-circuiting the cascade with a lie.
Branch 3 waits for the nREPL handshake up to
`hive-mcp-cider-connection-handshake-timeout' — the connect call is async and
returns its buffer long before the connection is usable."
  (elisp-cond
   ((and (featurep 'cider) (cider-connected-p))
    t)
   ((when-let* [session-name (-find-live-connected-session)]
      (message "hive-mcp-cider: Reusing session '%s'" session-name)
      (-switch-to-session session-name)))
   ((hive-mcp-cider-nrepl-port-open-p hive-mcp-cider-nrepl-port)
    (message "hive-mcp-cider: Auto-connecting to port %d" hive-mcp-cider-nrepl-port)
    (condition-case nil
        (let [conn (-connect-clj-no-prompt hive-mcp-cider-nrepl-port)]
          (or (-wait-for (lambda () (-connection-ready-p conn))
                         hive-mcp-cider-connection-handshake-timeout)
              (progn
                (message "hive-mcp-cider: %s" (describe-connectivity))
                nil)))
      (error nil)))
   (t
    (message "hive-mcp-cider: %s" (describe-connectivity))
    nil)))

;; ============================================================================
;; Auto-Connect Timer
;; ============================================================================

(defn- -try-connect-default []
  "Try to connect CIDER to the default nREPL port. Returns t if successful."
  (when (and (featurep 'cider)
             (fboundp 'cider-connect-clj)
             (not (cider-connected-p))
             (hive-mcp-cider-nrepl-port-open-p hive-mcp-cider-nrepl-port))
    (condition-case err
        (progn
          (-connect-clj-no-prompt hive-mcp-cider-nrepl-port)
          (message "hive-mcp-cider: Connected to nREPL on port %d" hive-mcp-cider-nrepl-port)
          t)
      (error
       (message "hive-mcp-cider: Connection failed: %s" (error-message-string err))
       nil))))

(defn- -auto-connect-tick []
  "Timer callback for auto-connect attempts."
  (condition-case err
      (progn
        (setq hive-mcp-cider-connection--auto-attempts
              (1+ hive-mcp-cider-connection--auto-attempts))
        (elisp-cond
         ((and (featurep 'cider) (cider-connected-p))
          (stop-auto-connect)
          (message "hive-mcp-cider: Already connected"))
         ((-try-connect-default)
          (stop-auto-connect))
         ((and (> hive-mcp-cider-connection-max-retries 0)
               (>= hive-mcp-cider-connection--auto-attempts
                   hive-mcp-cider-connection-max-retries))
          (stop-auto-connect)
          (message "hive-mcp-cider: Auto-connect gave up after %d attempts"
                   hive-mcp-cider-connection--auto-attempts))))
    (error
     (message "[cider] Auto-connect tick error: %s" (error-message-string err)))))

(defn start-auto-connect []
  "Start the auto-connect timer."
  (unless hive-mcp-cider-connection--auto-timer
    (setq hive-mcp-cider-connection--auto-attempts 0)
    (setq hive-mcp-cider-connection--auto-timer
          (run-with-timer hive-mcp-cider-connection-retry-interval
                          hive-mcp-cider-connection-retry-interval
                          #'-auto-connect-tick))
    (message "hive-mcp-cider: Auto-connect started (checking every %.1fs)"
             hive-mcp-cider-connection-retry-interval)))

(defn stop-auto-connect []
  "Stop the auto-connect timer."
  (when hive-mcp-cider-connection--auto-timer
    (cancel-timer hive-mcp-cider-connection--auto-timer)
    (setq hive-mcp-cider-connection--auto-timer nil)))
