(ns hive-mcp-cider-eval
  "CIDER nREPL evaluation with heartbeat polling and local CLJEL execution.")

(require 'cl-lib)

;; Dependencies on sibling modules
(declare-function hive-mcp-cider-sessions-lookup "hive-mcp-cider-sessions")
(declare-function hive-mcp-cider-sessions-update-prop "hive-mcp-cider-sessions")
(declare-function hive-mcp-cider-connection-ensure-connected "hive-mcp-cider-connection")
(declare-function hive-mcp-cider-connection-describe-connectivity "hive-mcp-cider-connection")

;; Dependencies on CIDER
(declare-function cider-nrepl-request:eval "cider-client")
(declare-function cider-interactive-eval "cider-eval")
(declare-function cider-interactive-eval-handler "cider-eval")
(declare-function cider-current-repl "cider-connection")
(declare-function nrepl-dict-get "nrepl-dict")
(declare-function nrepl-dict-put "nrepl-dict")
(declare-function nrepl-dict-p "nrepl-dict")
(declare-function nrepl-request:interrupt "nrepl-client")

;; ============================================================================
;; Configuration
;; ============================================================================

(defcustom hive-mcp-cider-eval-timeout 60
  "Timeout in seconds for nREPL evaluation with heartbeat polling."
  :type 'integer
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-eval-poll-interval 0.1
  "Interval in seconds between heartbeat polls during async eval.
Smaller values = more responsive, larger values = less CPU overhead."
  :type 'number
  :group 'hive-mcp-cider)

;; ============================================================================
;; Core Eval Engine
;; ============================================================================

;; Eval state layout: [value err out compiled state]. STATE values:
;;   nil     -- still waiting
;;   t       -- done, success
;;   'error  -- done, evaluation error
(defn make-eval-state []
  "Create a fresh eval-state vector: [value err out compiled state]."
  (make-vector 5 nil))

(defn response-error-p [status ex root-ex]
  "Return non-nil when nREPL response fields indicate evaluation failure."
  (or ex root-ex (member "eval-error" status)))

(defn apply-response [st response]
  "Fold one nREPL RESPONSE dict into eval-state vector ST; mutate and return ST.

`err' and `out' accumulate across chunks. A plain stderr write does not mark
the response failed; `eval-error', `ex', or `root-ex' does. Compiled CLJEL is
stored for local execution by `finalize-eval-state'."
  (let [value (nrepl-dict-get response "value")
        err (nrepl-dict-get response "err")
        out (nrepl-dict-get response "out")
        compiled (nrepl-dict-get response "cljel-compiled-elisp")
        ex (nrepl-dict-get response "ex")
        root-ex (nrepl-dict-get response "root-ex")
        status (nrepl-dict-get response "status")]
    (when value
      (aset st 0 value))
    (when err
      (aset st 1 (str (or (aref st 1) "") err)))
    (when out
      (aset st 2 (str (or (aref st 2) "") out)))
    (when compiled
      (aset st 3 compiled))
    (when (and (not err) (or root-ex ex))
      (aset st 1 (str (or (aref st 1) "") (or root-ex ex))))
    (when (response-error-p status ex root-ex)
      (aset st 4 'error))
    (when (member "done" status)
      (unless (aref st 4)
        (aset st 4 t)))
    st))

(defn- read-compiled-forms [compiled]
  "Read every top-level Elisp form in COMPILED and return them in source order."
  (let* [pos 0
         len (length compiled)
         forms nil]
    (condition-case nil
        (while (< pos len)
          (let* [res (read-from-string compiled pos)]
            (setq forms (cons (car res) forms))
            (setq pos (cdr res))))
      (end-of-file nil))
    (nreverse forms)))

(defn- execute-compiled-elisp [compiled]
  "Execute every top-level form in COMPILED and return the last printed result."
  (condition-case e
      (progn
        (unless (stringp compiled)
          (error "Invalid compiled Elisp payload: %S" compiled))
        (ignore-errors (require 'clojure-elisp-runtime nil t))
        (if (fboundp 'cider-cljel--eval-elisp-string)
            (cider-cljel--eval-elisp-string compiled)
          (let* [result nil]
            (dolist (form (read-compiled-forms compiled))
              (setq result (eval form t)))
            (format "%S" result))))
    (error (format "cljel client eval error: %S" e))))

(defn run-compiled [compiled]
  "Execute COMPILED cljel Elisp in Emacs and return its result as a string.
Single funnel for client-side execution: every eval entry point routes compiled
payloads through this function. Never signals — an execution failure is
returned as an error string."
  (execute-compiled-elisp compiled))

(defn compiled-payload [response]
  "Return the compiled Elisp string carried by nREPL RESPONSE, or nil."
  (nrepl-dict-get response "cljel-compiled-elisp"))

(defn- response-with-value [response value]
  "Return RESPONSE carrying VALUE under \"value\" for stock CIDER handlers.
RESPONSE is returned unchanged when it is not an nREPL dict."
  (if (and (fboundp 'nrepl-dict-p)
           (fboundp 'nrepl-dict-put)
           (nrepl-dict-p response))
      (nrepl-dict-put response "value" value)
    response))

(defn wrap-compiled-callback [callback]
  "Return an nREPL callback that runs cljel compiled Elisp, then calls CALLBACK.

A response carrying \"cljel-compiled-elisp\" is executed locally through
`run-compiled' and the result is attached to the response as \"value\", so a
stock CIDER handler displays it and a capture callback records it. Responses
without a compiled payload, and a nil CALLBACK, are passed through untouched."
  (lambda (response)
    (let [compiled (compiled-payload response)]
      (if (not compiled)
          (when callback (funcall callback response))
        (let [result (run-compiled compiled)]
          (if callback
              (funcall callback (response-with-value response result))
            (message "%s" result)))))))

(defn finalize-eval-state [st]
  "Compute the final result string from a completed eval-state ST.

Compiled Elisp delegates to the cider-cljel client helper when present, else
executes directly. Plain clj output precedes its value."
  (let [value (aref st 0)
        err (aref st 1)
        out (aref st 2)
        compiled (aref st 3)
        state (aref st 4)]
    (elisp-cond
     ((eq state 'error)
      (or err "Eval error"))
     (compiled
      (run-compiled compiled))
     ((and value out (not (string= "" out)))
      (str out value))
     (value value)
     ((and out (not (string= "" out)))
      out)
     (t "nil"))))

(defn- current-connection []
  "Return the CIDER REPL connection buffer for the current context, or nil."
  (when (fboundp 'cider-current-repl)
    (ignore-errors (cider-current-repl))))

(defn- connection-request-id [connection]
  "Return the id of the last request nREPL sent on CONNECTION, or nil.
Read immediately after a send, that id is the sent request's id."
  (when (and connection (bufferp connection) (buffer-live-p connection))
    (with-current-buffer connection
      (when (boundp 'nrepl-request-counter)
        (number-to-string nrepl-request-counter)))))

(defn interrupt-eval [request-id connection]
  "Send an nREPL interrupt for REQUEST-ID over CONNECTION.
Returns non-nil when an interrupt was dispatched, nil when it could not be."
  (when (and request-id connection (fboundp 'nrepl-request:interrupt))
    (ignore-errors
      (nrepl-request:interrupt request-id (lambda (_response) nil) connection)
      t)))

(defn eval-with-heartbeat [code &optional timeout-override]
  "Evaluate CODE and return its result string, or signal on timeout.
Optional TIMEOUT-OVERRIDE in seconds (default: `hive-mcp-cider-eval-timeout').

Contract: the nREPL request is asynchronous but this call is SYNCHRONOUS — it
polls `accept-process-output' every `hive-mcp-cider-eval-poll-interval' and
blocks the Emacs command loop until the response is complete, which is what the
headless MCP backend needs from a request/response tool call. Do not call it
from inside another eval running in this same Emacs.

Async state lives in a closure-local eval-state vector (see `make-eval-state');
the callback folds each nREPL response into it via `apply-response', and
`finalize-eval-state' turns the completed state into the result string —
executing compiled cljel locally in Emacs when the session is cljel-active.
On timeout an nREPL interrupt is sent for the pending request so the server
stops evaluating and the session is not left wedged."
  (let [st (make-eval-state)
        id-cell (make-vector 1 nil)
        connection (current-connection)]
    ;; Send async request — callback folds responses into the local state
    (cider-nrepl-request:eval
     code
     (lambda (response)
       (let [id (nrepl-dict-get response "id")]
         (when id (aset id-cell 0 id)))
       (apply-response st response)))
    (unless (aref id-cell 0)
      (aset id-cell 0 (connection-request-id connection)))
    ;; Poll with heartbeat until done or timeout
    (let [start-time (float-time)
          timeout (or timeout-override hive-mcp-cider-eval-timeout)
          interval hive-mcp-cider-eval-poll-interval]
      (while (and (not (aref st 4))
                  (< (- (float-time) start-time) timeout))
        (accept-process-output nil interval))
      (if (not (aref st 4))
          (let [interrupted (interrupt-eval (aref id-cell 0) connection)]
            (error "Eval timed out after %s seconds (synchronous heartbeat poll); server interrupt %s"
                   timeout (if interrupted "sent" "NOT sent")))
        (finalize-eval-state st)))))

;; ============================================================================
;; Session-Routed Eval
;; ============================================================================

(defn not-connected-message [name session]
  "Return the error text for SESSION named NAME whose status is not 'connected.
The registry's :reason is appended when one was recorded, so a handshake
timeout or a connect error is reported instead of a bare status symbol."
  (let [reason (plist-get session :reason)]
    (format "Session '%s' not connected (status: %s)%s"
            name
            (plist-get session :status)
            (if reason (format " — %s" reason) ""))))

(defn cljel-upgrade-failed-p [session]
  "Return non-nil when SESSION claims repl-type 'cljel but its upgrade failed.
Asserts the recorded :cljel-upgrade instead of trusting :repl-type alone."
  (and (eq (plist-get session :repl-type) 'cljel)
       (eq (plist-get session :cljel-upgrade) 'failed)
       t))

(defn eval-in-session [name code &optional timeout]
  "Evaluate CODE in the CIDER session NAME.
Optional TIMEOUT in seconds (default: `hive-mcp-cider-eval-timeout').
Uses the synchronous heartbeat poll of `eval-with-heartbeat'.
Refuses any session that is not 'connected (surfacing its registry :reason)
and any cljel session whose upgrade did not confirm."
  (let* [session (hive-mcp-cider-sessions-lookup name)
         cider-buf (plist-get session :cider-buffer)]
    (unless session
      (error "Session '%s' not found" name))
    (unless (eq (plist-get session :status) 'connected)
      (error "%s" (not-connected-message name session)))
    (when (cljel-upgrade-failed-p session)
      (error "Session '%s' never upgraded to cljel (cljel-upgrade: failed) — reconnect it or evaluate as clj"
             name))
    (unless (and cider-buf (buffer-live-p (get-buffer cider-buf)))
      (ignore-errors
        (hive-mcp-cider-sessions-update-prop name :status 'stale))
      (error "Session '%s' REPL buffer is gone" name))
    (with-current-buffer cider-buf
      (eval-with-heartbeat code timeout))))

;; ============================================================================
;; MCP API Eval Functions
;; ============================================================================

(defn eval-silent [code &optional timeout]
  "Evaluate CODE via CIDER silently, return result.
Optional TIMEOUT in seconds.
Auto-connects if not connected, reusing existing session if available; when the
connection cannot be established the error carries the connectivity diagnosis
(closed socket vs. an nREPL that never completed the CIDER handshake)."
  (unless (hive-mcp-cider-connection-ensure-connected)
    (error "%s" (hive-mcp-cider-connection-describe-connectivity)))
  (eval-with-heartbeat code timeout))

(defn- interactive-handler []
  "Return CIDER's interactive eval handler for the current buffer, or nil."
  (when (fboundp 'cider-interactive-eval-handler)
    (cider-interactive-eval-handler)))

(defn eval-explicit [code]
  "Evaluate CODE via CIDER interactively.
Shows output in REPL buffer for collaborative debugging.
A cljel session's compiled Elisp is executed in Emacs by
`wrap-compiled-callback' before CIDER's handler sees the response, so an
explicit eval is never a silent no-op.
Auto-connects if not connected, and reports the connectivity diagnosis when
that fails."
  (unless (hive-mcp-cider-connection-ensure-connected)
    (error "%s" (hive-mcp-cider-connection-describe-connectivity)))
  (cider-interactive-eval code (wrap-compiled-callback (interactive-handler)))
  (format "Sent to REPL: %s" (truncate-string-to-width code 50 nil nil "...")))
