(ns hive-mcp-cider-nrepl
  "nREPL process management and port utilities.

Handles OS-level process spawning, command building, and network port probing.
Independent of CIDER — only knows about nREPL as a subprocess.

Design principles (SOLID/CLARITY):
- Single Responsibility: Only manages nREPL OS processes and port detection
- Open/Closed: New REPL types add a pcase branch, nothing else changes
- Pure where possible: build-command is a pure function")

(require 'cl-lib)
(require 'parseedn)

;; ============================================================================
;; Configuration
;; ============================================================================

(defcustom hive-mcp-cider-nrepl-port 7910
  "Default port for nREPL server."
  :type 'integer
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-nrepl-project-dir nil
  "Project directory for starting nREPL.
If nil, callers MUST supply project-dir explicitly (no project-current
fallback — the Emacs daemon's current buffer is rarely the right project
when spawn is triggered from an MCP tool boundary)."
  :type '(choice (const nil) directory)
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-nrepl-default-project-dir "~/PP/hive/hive-mcp"
  "Fallback working directory for the default nREPL server.
Used by `hive-mcp-cider-nrepl-start-default' when neither an explicit DIR nor
`hive-mcp-cider-nrepl-project-dir' is given. Nil disables the fallback, making
start-default error instead of guessing."
  :type '(choice (const nil) directory)
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-nrepl-cljel-project-dir "~/PP/clojure-elisp"
  "Project directory for ClojureElisp nREPL sessions.
Should point to the clojure-elisp project root with deps.edn
containing the compiler and nREPL middleware."
  :type 'directory
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-nrepl-shadow-build ":app"
  "Default shadow-cljs build ID."
  :type 'string
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-nrepl-version "1.7.0"
  "nREPL version for inline -Sdeps spawn."
  :type 'string
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-nrepl-cider-nrepl-version "0.62.2"
  "cider-nrepl version for inline -Sdeps spawn."
  :type 'string
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-nrepl-launch-aliases nil
  "Clojure CLI aliases added to the spawn command, as bare names without colons.
Nil launches with plain -M and the inline -Sdeps, which works in any project.
Example: '(\"dev\") launches clojure -Sdeps ... -M:dev -m nrepl.cmdline."
  :type '(repeat string)
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-nrepl-local-deps-files '("local.deps.edn")
  "Files probed in the spawn working directory for -Sdeps layering.
Each existing file's contents splice into the spawn command as an extra
-Sdeps, after the built-in one and before -M — the spawn-time equivalent of
-Sdeps \"$(cat <file>)\". Nil disables detection."
  :type '(repeat string)
  :group 'hive-mcp-cider)

;; ============================================================================
;; Internal State
;; ============================================================================

(defvar hive-mcp-cider-nrepl--default-process nil
  "Process object for the auto-started default nREPL server.")

;; ============================================================================
;; Pure Functions
;; ============================================================================

(defn launch-flag [aliases]
  "Return the clojure CLI main flag for ALIASES, a list of bare alias names.
Nil or empty ALIASES yields \"-M\"; '(\"dev\" \"test\") yields \"-M:dev:test\".
A leading colon on an alias name is tolerated. This is a pure function."
  (let [names (delq nil
                    (mapcar (lambda (a)
                              (let [s (format "%s" (or a ""))]
                                (unless (string= "" s)
                                  (if (string-prefix-p ":" s) (substring s 1) s))))
                            aliases))]
    (if names
        (elisp-concat "-M" (mapconcat (lambda (n) (elisp-concat ":" n)) names ""))
      "-M")))

(defn local-deps-contents [dir]
  "Return the contents of `hive-mcp-cider-nrepl-local-deps-files' present in
DIR, in probe order. Nil when none exist or detection is off."
  (when (and dir (listp hive-mcp-cider-nrepl-local-deps-files))
    (delq nil
          (mapcar (lambda (f)
                    (let [path (expand-file-name f dir)]
                      (when (file-readable-p path)
                        (with-temp-buffer
                          (insert-file-contents path)
                          (buffer-string)))))
                  hive-mcp-cider-nrepl-local-deps-files))))

(defn- -deep-merge [base override]
  "Merge OVERRIDE hash-table into BASE hash-table recursively, in place.
Nested maps merge key-wise; any other value is replaced. Returns BASE."
  (maphash (lambda (k v)
             (puthash k (let [old (gethash k base)]
                          (if (and (hash-table-p old) (hash-table-p v))
                              (-deep-merge old v)
                            v))
                      base))
           override)
  base)

(defn merge-deps-edn [base-str override-strs]
  "Merge the deps EDN map BASE-STR with each of OVERRIDE-STRS, in order, and
return a single EDN string. The clojure CLI keeps only the LAST -Sdeps (the
bash script assigns one var), so layered deps must be merged into one map:
-Sdeps A -Sdeps B discards A entirely."
  (let [merged (parseedn-read-str base-str)]
    (dolist (s override-strs)
      (when (and (stringp s) (not (string= "" s)))
        (-deep-merge merged (parseedn-read-str s))))
    (parseedn-print-str merged)))

(defn build-command [repl-type port &optional extra-args aliases extra-deps middleware]
  "Build the nREPL start command for REPL-TYPE on PORT.
Returns a list of (program . args) for `start-process'; the caller owns the
working directory. REPL-TYPE is one of 'clj, 'cljs, or 'cljel.
Uses inline -Sdeps plus ALIASES (default `hive-mcp-cider-nrepl-launch-aliases')
so spawn works in any project without requiring a :nrepl or :dev alias.
EXTRA-DEPS is a list of deps EDN strings (e.g. local.deps.edn contents)
merged into the built-in -Sdeps map via `merge-deps-edn' — the CLI keeps
only the last -Sdeps, so layering must merge, not repeat the flag.
MIDDLEWARE is a list of nREPL middleware symbol strings appended to the
built-in list for REPL-TYPE.
EXTRA-ARGS is a list of raw CLI args spliced after -Sdeps and before the -M
main flag (e.g. '(\"-Srepro\") or JVM opts); everything after -M is
main-opts, so CLI opts must precede it.
This is a pure function — no side effects."
  (let [port-str (number-to-string port)
        main-flag (launch-flag (or aliases hive-mcp-cider-nrepl-launch-aliases))
        clj-deps (format "{:deps {nrepl/nrepl {:mvn/version \"%s\"} cider/cider-nrepl {:mvn/version \"%s\"}}}"
                         hive-mcp-cider-nrepl-version
                         hive-mcp-cider-nrepl-cider-nrepl-version)
        cljel-deps (format "{:deps {nrepl/nrepl {:mvn/version \"%s\"} cider/cider-nrepl {:mvn/version \"%s\"} io.github.BuddhiLW/clojure-elisp {:local/root \"%s\"}}}"
                           hive-mcp-cider-nrepl-version
                           hive-mcp-cider-nrepl-cider-nrepl-version
                           (expand-file-name hive-mcp-cider-nrepl-cljel-project-dir))
        sdeps-for (lambda (base)
                    (if extra-deps
                        (merge-deps-edn base extra-deps)
                      base))
        mw-for (lambda (built-ins)
                 (elisp-concat "["
                               (mapconcat (lambda (m) (format "%s" m))
                                          (append built-ins middleware) ",")
                               "]"))]
    (pcase repl-type
      ('cljs
       (list "npx" "shadow-cljs" "watch" hive-mcp-cider-nrepl-shadow-build))
      ('cljel
       (append (list "clojure" "-Sdeps" (funcall sdeps-for cljel-deps))
               extra-args
               (list main-flag "-m" "nrepl.cmdline"
                     "--port" port-str
                     "--middleware"
                     (funcall mw-for '("cider.nrepl/cider-middleware"
                                       "clojure-elisp.nrepl/wrap-cljel")))))
      (_
       (append (list "clojure" "-Sdeps" (funcall sdeps-for clj-deps))
               extra-args
               (list main-flag "-m" "nrepl.cmdline"
                     "--port" port-str
                     "--middleware"
                     (funcall mw-for '("cider.nrepl/cider-middleware"))))))))

(defn project-dir [repl-type]
  "Resolve the project directory for REPL-TYPE.
Returns absolute path string, or nil if no explicit dir is configured.

For 'cljel — falls back to `hive-mcp-cider-nrepl-cljel-project-dir'
defcustom (the cljel toolchain has a single canonical project).

For 'clj/'cljs — returns nil if `hive-mcp-cider-nrepl-project-dir' is
unset. Callers must supply project-dir explicitly. The Emacs daemon's
current buffer is NOT a reliable proxy when spawn is triggered from an
MCP tool boundary — it leaks hive-mcp into every other project's REPL."
  (or hive-mcp-cider-nrepl-project-dir
      (when (eq repl-type 'cljel)
        (expand-file-name hive-mcp-cider-nrepl-cljel-project-dir))))

(defn default-project-dir [dir]
  "Resolve the working directory for the default nREPL server.
DIR wins, then `hive-mcp-cider-nrepl-project-dir', then
`hive-mcp-cider-nrepl-default-project-dir'. Returns an absolute path
string, or nil when none of the three is a non-empty string."
  (let [candidate (or dir
                      hive-mcp-cider-nrepl-project-dir
                      hive-mcp-cider-nrepl-default-project-dir)]
    (when (and (stringp candidate) (not (string= "" candidate)))
      (expand-file-name candidate))))

;; ============================================================================
;; Port Utilities
;; ============================================================================

(defn port-open-p [port]
  "Check if PORT is accepting connections on localhost.
Returns t if port is open, nil otherwise."
  (condition-case nil
      (let [proc (make-network-process
                   :name "nrepl-check"
                   :host "localhost"
                   :service port
                   :nowait nil)]
        (delete-process proc)
        t)
    (error nil)))

;; ============================================================================
;; Process Lifecycle
;; ============================================================================

(defn launch-process [name port repl-type &optional dir extra-args aliases extra-deps middleware]
  "Start an nREPL process named NAME on PORT for REPL-TYPE.
Optional DIR overrides the working directory.
`local-deps-contents' of the resolved dir (e.g. local.deps.edn) merge into
the built-in -Sdeps ahead of EXTRA-DEPS (later entries win key-wise).
EXTRA-ARGS splice raw before -M; ALIASES select -M; MIDDLEWARE appends
nREPL middleware symbol strings to the built-in list.
Errors if no dir can be resolved — explicit project routing only.
Returns the process object."
  (let* [resolved-dir (or dir (project-dir repl-type))]
    (unless resolved-dir
      (error "hive-mcp-cider-nrepl: no project-dir for session '%s' (type=%s) — pass project-dir explicitly or set `hive-mcp-cider-nrepl-project-dir'"
             name (symbol-name repl-type)))
    (let* [default-directory (file-name-as-directory resolved-dir)
           buf-name (format "*nREPL-%s*" name)
           cmd (build-command repl-type port
                              extra-args
                              aliases
                              (append (local-deps-contents resolved-dir) extra-deps)
                              middleware)]
      (apply #'start-process (format "nrepl-%s" name) buf-name cmd))))

(defn stop-process [process]
  "Kill a running nREPL process."
  (when (and process (process-live-p process))
    (kill-process process)))

(defn start-default [&optional dir]
  "Start the default nREPL server on `hive-mcp-cider-nrepl-port'.
The working directory is `default-project-dir' of DIR; the command is
`build-command' for 'clj with `local-deps-contents' of the resolved
directory merged into the built-in -Sdeps, so no project alias is required
and a local deps override is honored.
Signals an error naming the unset settings when no directory resolves, and
another when the resolved directory does not exist. Returns the process."
  (interactive)
  (let* [resolved (default-project-dir dir)]
    (unless resolved
      (error "hive-mcp-cider-nrepl: no directory for the default nREPL server — pass DIR, or set `hive-mcp-cider-nrepl-project-dir' or `hive-mcp-cider-nrepl-default-project-dir'"))
    (unless (file-directory-p resolved)
      (error "hive-mcp-cider-nrepl: default nREPL directory does not exist: %s" resolved))
    (let* [default-directory (file-name-as-directory resolved)
           cmd (build-command 'clj hive-mcp-cider-nrepl-port
                              nil nil
                              (local-deps-contents resolved))]
      (message "hive-mcp-cider-nrepl: Starting on port %s in %s..."
               hive-mcp-cider-nrepl-port default-directory)
      (setq hive-mcp-cider-nrepl--default-process
            (apply #'start-process "nrepl-server" "*nREPL-server*" cmd)))))

(defn stop-default []
  "Stop the default nREPL server."
  (stop-process hive-mcp-cider-nrepl--default-process)
  (setq hive-mcp-cider-nrepl--default-process nil)
  (message "hive-mcp-cider-nrepl: Default server stopped"))
