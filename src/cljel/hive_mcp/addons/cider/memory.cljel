(ns hive-mcp-cider-memory
  "Memory integration for CIDER — capture REPL results, save snippets, query memory.

Capture is advice on `cider-nrepl-request:eval', the single funnel every CIDER
evaluation goes through. The advice wraps the caller's own nREPL callback, folds
the response into `hive-mcp-cider-memory--last-eval' on \"done\", and delegates —
so REPL echo and error handling stay CIDER's. `toggle-auto-log' installs and
removes that advice; the boolean and the advice can never disagree.

Design principles (SOLID/CLARITY):
- Single Responsibility: Only handles memory capture/save/query operations
- Dependency Inversion: Uses hive-mcp-api for memory ops, not direct storage
- Pure decisions (capture-result-p, merge-capture, query-plan), effects at edges")

(require 'cl-lib)

;; Dependencies
(declare-function hive-mcp-api-memory-add "hive-mcp-api")
(declare-function hive-mcp-api-memory-query "hive-mcp-api")
(declare-function hive-mcp-api-get-context "hive-mcp-api")
(declare-function hive-mcp-memory-search "hive-mcp-memory")
(declare-function cider-current-ns "cider-client")
(declare-function cider-interactive-eval "cider-eval")
(declare-function cider-interactive-eval-handler "cider-eval")
(declare-function cider-last-sexp "cider-eval")
(declare-function cider-nrepl-request:eval "cider-client")
(declare-function nrepl-dict-get "nrepl-dict")

;; ============================================================================
;; Configuration
;; ============================================================================

(defcustom hive-mcp-cider-memory-auto-log nil
  "When non-nil, REPL results are captured for later saving to memory.
Set by `hive-mcp-cider-memory-toggle-auto-log', which also installs or removes
the capture advice — do not set it directly."
  :type 'boolean
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-memory-log-threshold 0
  "Minimum result length to capture; 0 captures every result."
  :type 'integer
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-memory-query-limit 20
  "Maximum number of memory entries `hive-mcp-cider-memory-query-solutions' shows."
  :type 'integer
  :group 'hive-mcp-cider)

(defconst hive-mcp-cider-memory-eval-advice-target 'cider-nrepl-request:eval
  "CIDER function advised to capture evaluation results.
Every interactive and programmatic CIDER eval funnels through it.")

;; ============================================================================
;; Internal State
;; ============================================================================

(defvar hive-mcp-cider-memory--last-eval nil
  "Last captured evaluation as a plist of :expr, :ns, :result and :context.")

;; ============================================================================
;; Capture Decisions (pure)
;; ============================================================================

(defn capture-result-p [result threshold]
  "Return non-nil when RESULT is worth recording under THRESHOLD."
  (and result
       (>= (length (format "%s" result)) (or threshold 0))
       t))

(defn merge-capture [prev expr ns result]
  "Return the capture plist for EXPR, NS and RESULT.
PREV's :context survives when PREV describes the same expression, so an
eval started by `hive-mcp-cider-memory-eval-with-context' keeps its context
once the asynchronous result arrives."
  (list :expr expr
        :ns ns
        :result result
        :context (when (and prev (equal expr (plist-get prev :expr)))
                   (plist-get prev :context))))

(defn format-entry [capture]
  "Render CAPTURE, a capture plist, as memory entry content."
  (let* [ctx (plist-get capture :context)
         buffer (plist-get (plist-get ctx :buffer) :name)
         project (plist-get (plist-get ctx :project) :name)]
    (elisp-concat
     (format "Namespace: %s\nExpression: %s\nResult: %s"
             (plist-get capture :ns)
             (plist-get capture :expr)
             (plist-get capture :result))
     (if ctx (format "\nContext: %s @ %s" buffer project) ""))))

;; ============================================================================
;; nREPL Response Reading
;; ============================================================================

(defn response-result [response]
  "Return the result payload carried by nREPL RESPONSE, or nil.
A cljel session answers with compiled Elisp instead of a printed value."
  (or (nrepl-dict-get response "value")
      (nrepl-dict-get response "cljel-compiled-elisp")))

(defn response-done-p [response]
  "Return non-nil when nREPL RESPONSE closes its request."
  (and (member "done" (nrepl-dict-get response "status")) t))

;; ============================================================================
;; Capture Boundary
;; ============================================================================

(defn- current-ns []
  "Return the current CIDER namespace, or nil when CIDER is absent."
  (when (fboundp 'cider-current-ns) (ignore-errors (cider-current-ns))))

(defn note-eval [expr ns result]
  "Record EXPR, NS and RESULT as the last capture when RESULT clears threshold.
Returns the stored capture plist, or nil when RESULT was rejected."
  (when (capture-result-p result hive-mcp-cider-memory-log-threshold)
    (setq hive-mcp-cider-memory--last-eval
          (merge-capture hive-mcp-cider-memory--last-eval expr ns result))))

(defn make-capture-callback [expr ns callback]
  "Return an nREPL callback recording EXPR's result, then delegating to CALLBACK.
Values accumulate across response chunks; the capture lands on \"done\"."
  (let [acc (make-vector 1 nil)]
    (lambda (response)
      (let [value (response-result response)]
        (when value (aset acc 0 value)))
      (when (response-done-p response)
        (note-eval expr ns (aref acc 0)))
      (when callback (funcall callback response)))))

(defn eval-request-advice [orig-fun input callback &rest args]
  "Advice around ORIG-FUN, `cider-nrepl-request:eval', capturing INPUT's result.
CALLBACK is wrapped while auto-log is on; ARGS are forwarded unchanged."
  (apply orig-fun input
         (if hive-mcp-cider-memory-auto-log
             (make-capture-callback input (current-ns) callback)
           callback)
         args))

(defn auto-log-enabled-p []
  "Return non-nil when the capture advice is installed."
  (and (advice-member-p #'hive-mcp-cider-memory-eval-request-advice
                        hive-mcp-cider-memory-eval-advice-target)
       t))

(defn enable-auto-log []
  "Install the capture advice and turn auto-log on."
  (advice-add hive-mcp-cider-memory-eval-advice-target
              :around #'hive-mcp-cider-memory-eval-request-advice)
  (setq hive-mcp-cider-memory-auto-log t))

(defn disable-auto-log []
  "Remove the capture advice and turn auto-log off."
  (advice-remove hive-mcp-cider-memory-eval-advice-target
                 #'hive-mcp-cider-memory-eval-request-advice)
  (setq hive-mcp-cider-memory-auto-log nil))

(defn toggle-auto-log []
  "Toggle automatic capture of REPL results.
Returns the new state."
  (interactive)
  (if (auto-log-enabled-p) (disable-auto-log) (enable-auto-log))
  (message "Auto-log %s" (if hive-mcp-cider-memory-auto-log "enabled" "disabled"))
  hive-mcp-cider-memory-auto-log)

;; ============================================================================
;; Save Operations
;; ============================================================================

(defn save-last-result []
  "Save the last captured REPL result to memory."
  (interactive)
  (if hive-mcp-cider-memory--last-eval
      (let* [tags (split-string
                    (read-string "Tags (comma-separated): " "clojure,repl")
                    "," t " ")
             content (format-entry hive-mcp-cider-memory--last-eval)]
        (hive-mcp-api-memory-add "snippet" content tags)
        (message "Saved REPL result to memory")
        content)
    (do
      (message "No recent REPL result to save")
      nil)))

(defn save-defun []
  "Save the current function definition to memory."
  (interactive)
  (let* [bounds (bounds-of-thing-at-point 'defun)
         defun-text (when bounds
                       (buffer-substring-no-properties (car bounds) (cdr bounds)))
         ns (current-ns)]
    (if defun-text
        (let* [tags (split-string
                      (read-string "Tags (comma-separated): " "clojure,function")
                      "," t " ")
               content (format "Namespace: %s\n\n%s" ns defun-text)]
          (hive-mcp-api-memory-add "snippet" content tags)
          (message "Saved function to memory")
          content)
      (do
        (message "No function at point")
        nil))))

;; ============================================================================
;; Query Operations
;; ============================================================================

(defn query-plan [query limit semantic-available]
  "Return the memory lookup plan for QUERY under LIMIT.
Free text goes to semantic search when SEMANTIC-AVAILABLE; otherwise its
whitespace-separated words become extra tags on a typed snippet query. An empty
QUERY keeps the plain clojure-tagged listing."
  (let [terms (when query (split-string query nil t))]
    (elisp-cond
     ((null terms)
      (list :mode 'tags :type "snippet" :tags '("clojure") :limit limit))
     (semantic-available
      (list :mode 'semantic :query query :limit limit))
     (t
      (list :mode 'tags :type "snippet"
            :tags (cons "clojure" terms) :limit limit)))))

(defn run-plan [plan]
  "Execute the `hive-mcp-cider-memory-query-plan' PLAN and return its entries."
  (if (eq 'semantic (plist-get plan :mode))
      (hive-mcp-memory-search (plist-get plan :query) nil (plist-get plan :limit))
    (hive-mcp-api-memory-query (plist-get plan :type)
                               (plist-get plan :tags)
                               (plist-get plan :limit))))

(defn entry-seq [results]
  "Normalize RESULTS, a vector or list, to a list."
  (elisp-cond
   ((null results) '())
   ((vectorp results) (append results '()))
   ((listp results) results)
   (t '())))

(defn entry-field [entry key]
  "Read KEY, a symbol such as `content', from ENTRY.
ENTRY may be alist-shaped (API results) or plist-shaped (memory results)."
  (elisp-cond
   ((null entry) nil)
   ((and (consp entry) (consp (car entry))) (alist-get key entry))
   ((listp entry) (plist-get entry (intern (elisp-concat ":" (symbol-name key)))))
   (t nil)))

(defn render-entries [plan entries]
  "Return the buffer text listing ENTRIES retrieved by PLAN."
  (let [text (format ";; === Clojure Solutions from Memory (%s: %s) ===\n\n"
                     (plist-get plan :mode)
                     (or (plist-get plan :query)
                         (mapconcat #'identity (plist-get plan :tags) ", ")))
        index 0]
    (if (null entries)
        (elisp-concat text ";; No solutions found\n")
      (do
        (dolist (entry entries)
          (setq index (1+ index))
          (setq text
                (elisp-concat
                 text
                 (format ";; --- Entry %d [%s] ---\n" index
                         (mapconcat #'identity
                                    (entry-seq (entry-field entry 'tags)) ", "))
                 (format "%s" (or (entry-field entry 'content) ""))
                 "\n\n")))
        text))))

(defn query-solutions [query]
  "Query memory for Clojure solutions matching QUERY."
  (interactive "sSearch memory for: ")
  (let* [plan (query-plan query
                          hive-mcp-cider-memory-query-limit
                          (fboundp 'hive-mcp-memory-search))
         entries (entry-seq (run-plan plan))
         buf (get-buffer-create "*MCP Clojure Solutions*")]
    (with-current-buffer buf
      (erase-buffer)
      (when (fboundp 'clojure-mode) (clojure-mode))
      (insert (render-entries plan entries))
      (goto-char (point-min)))
    (display-buffer buf)
    buf))

;; ============================================================================
;; Eval with Context
;; ============================================================================

(defn- interactive-callback [expr ns]
  "Return the nREPL callback for an interactive eval of EXPR in NS.
CIDER's own handler is wrapped with capture only when the auto-log advice is
absent, so a result is recorded exactly once either way."
  (let [handler (when (fboundp 'cider-interactive-eval-handler)
                  (cider-interactive-eval-handler))]
    (if (auto-log-enabled-p)
        handler
      (make-capture-callback expr ns handler))))

(defn eval-with-context []
  "Evaluate the last expression, recording MCP context with its result."
  (interactive)
  (when (fboundp 'cider-interactive-eval)
    (let* [ctx (hive-mcp-api-get-context)
           expr (when (fboundp 'cider-last-sexp) (cider-last-sexp))
           ns (current-ns)]
      (setq hive-mcp-cider-memory--last-eval
            (list :expr expr :ns ns :result nil :context ctx))
      (cider-interactive-eval expr (interactive-callback expr ns))
      expr)))
