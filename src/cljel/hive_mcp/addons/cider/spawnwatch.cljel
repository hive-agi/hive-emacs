(ns hive-mcp-cider-spawnwatch
  "Publish the CIDER session registry to a file hive-emacs reads.

A spawn answers `starting' and settles seconds later. An agent cannot ask
Emacs how it went: the jack-in the spawn started may hold a minibuffer prompt
open, and every emacsclient call blocks until it is answered. So the registry
is published to <root>/<server-name>/cider-spawns.json from a timer, the same
channel `hive-mcp-attention' uses, and the JVM half reads the outcome from
disk.")

(require 'cl-lib)
(require 'json)
(require 'hive-mcp-cider-sessions)

;; ============================================================================
;; Configuration
;; ============================================================================

(defcustom hive-mcp-cider-spawnwatch-directory nil
  "Root under which this daemon publishes its CIDER session state.
nil derives it: $HIVE_EMACS_ATTENTION_DIR, else $XDG_RUNTIME_DIR/hive-emacs,
else hive-emacs-<uid> under `temporary-file-directory'. hive-emacs on the JVM
derives the same root, so change both or neither."
  :type '(choice (const :tag "Derived" nil) directory)
  :group 'hive-mcp-cider)

(defcustom hive-mcp-cider-spawnwatch-poll-interval 1.0
  "Seconds between registry publications."
  :type 'number
  :group 'hive-mcp-cider)

;; ============================================================================
;; State
;; ============================================================================

(defvar hive-mcp-cider-spawnwatch--root nil
  "Root hive-emacs handed us, or nil to derive it.")

(defvar hive-mcp-cider-spawnwatch--timer nil
  "Repeating timer that refreshes the published registry.")

(defvar hive-mcp-cider-spawnwatch--last nil
  "Sessions as last published, so an unchanged registry is not rewritten.")

(defvar hive-mcp-cider-spawnwatch--last-error nil
  "Message of the last timer error, for diagnostics.")

;; ============================================================================
;; Paths
;; ============================================================================

(defn- derived-root []
  "Root derived from customization and environment, for a manual `enable'."
  (or hive-mcp-cider-spawnwatch-directory
      (let [override (getenv "HIVE_EMACS_ATTENTION_DIR")]
        (when (and override (not (string-empty-p override)))
          override))
      (let [runtime (getenv "XDG_RUNTIME_DIR")]
        (when (and runtime (file-directory-p runtime))
          (expand-file-name "hive-emacs" runtime)))
      (expand-file-name (format "hive-emacs-%d" (user-uid))
                        temporary-file-directory)))

(defn root-directory []
  "Directory under which every daemon publishes its session state."
  (or hive-mcp-cider-spawnwatch--root (derived-root)))

(defn daemon-directory []
  "This daemon's directory: the root joined with `server-name'."
  (expand-file-name (or (bound-and-true-p server-name) "server")
                    (root-directory)))

(defn state-file []
  "Path of the published registry."
  (expand-file-name "cider-spawns.json" (daemon-directory)))

;; ============================================================================
;; Pure Decisions
;; ============================================================================

(defn unsettled-p [status]
  "Return non-nil when STATUS means a spawn has not reached its outcome.
STATUS is the string `hive-mcp-cider-sessions-list-all' projects."
  (and (member status '("starting" "connecting")) t))

(defn any-unsettled-p [sessions]
  "Return non-nil when any of SESSIONS is still on its way to an outcome."
  (and (cl-some (lambda (session)
                  (unsettled-p (plist-get session :status)))
                sessions)
       t))

(defn republish-p [sessions last]
  "Return non-nil when SESSIONS must be written although LAST was published.
An unsettled spawn is republished every tick so its heartbeat stays fresh;
otherwise only a change is worth a write."
  (or (any-unsettled-p sessions)
      (not (equal sessions last))))

;; ============================================================================
;; Publishing
;; ============================================================================

(defn- reconcile []
  "Demote sessions whose `connected' claim is contradicted by reality.
A no-op when the connection module is not loaded."
  (when (fboundp 'hive-mcp-cider-connection-reconcile-sessions)
    (ignore-errors (hive-mcp-cider-connection-reconcile-sessions))))

(defn- write-state [plist]
  "Atomically publish PLIST as JSON, in a directory only this user can read."
  (let [dir (daemon-directory)
        file (state-file)
        tmp (format "%s.tmp" file)
        coding-system-for-write 'utf-8]
    (with-file-modes 448
      (make-directory dir t)
      (with-temp-file tmp
        (insert (json-encode plist))))
    (rename-file tmp file t)))

(defn- clear-state []
  "Remove the published registry, if any."
  (let [file (state-file)]
    (when (file-exists-p file)
      (ignore-errors (delete-file file))))
  (setq hive-mcp-cider-spawnwatch--last nil))

(defn publish []
  "Publish the session registry when it changed or a spawn is unsettled.
Returns the sessions considered."
  (let [sessions (hive-mcp-cider-sessions-list-all)]
    (when (republish-p sessions hive-mcp-cider-spawnwatch--last)
      (setq hive-mcp-cider-spawnwatch--last sessions)
      (write-state (list :server (or (bound-and-true-p server-name) "server")
                         :pid (emacs-pid)
                         :heartbeat (float-time)
                         :sessions sessions)))
    sessions))

(defn- tick []
  "Timer body: reconcile, then refresh the published registry. Never signals."
  (condition-case err
      (progn
        (reconcile)
        (publish))
    (error
     (setq hive-mcp-cider-spawnwatch--last-error (error-message-string err)))))

;; ============================================================================
;; Lifecycle
;; ============================================================================

(defn enabled-p []
  "Non-nil when publishing is active."
  (and (timerp hive-mcp-cider-spawnwatch--timer) t))

(defn enable [&optional root]
  "Start publishing the CIDER session registry under ROOT. Idempotent.
hive-emacs passes the root it reads from, so both sides agree by construction;
a nil ROOT falls back to `hive-mcp-cider-spawnwatch-directory' and the
environment."
  (setq hive-mcp-cider-spawnwatch--root
        (if (and (stringp root) (not (string-empty-p root)))
            (expand-file-name root)
          (derived-root)))
  (setq hive-mcp-cider-spawnwatch--last nil)
  (add-hook 'kill-emacs-hook #'hive-mcp-cider-spawnwatch--clear-state)
  (when (timerp hive-mcp-cider-spawnwatch--timer)
    (cancel-timer hive-mcp-cider-spawnwatch--timer))
  (setq hive-mcp-cider-spawnwatch--timer
        (run-at-time hive-mcp-cider-spawnwatch-poll-interval
                     hive-mcp-cider-spawnwatch-poll-interval
                     #'hive-mcp-cider-spawnwatch--tick))
  (tick)
  t)

(defn disable []
  "Stop publishing and remove the state file. Idempotent."
  (remove-hook 'kill-emacs-hook #'hive-mcp-cider-spawnwatch--clear-state)
  (when (timerp hive-mcp-cider-spawnwatch--timer)
    (cancel-timer hive-mcp-cider-spawnwatch--timer))
  (setq hive-mcp-cider-spawnwatch--timer nil)
  (clear-state)
  t)

(defn status []
  "JSON status for diagnostics over emacsclient (when emacsclient works)."
  (json-encode (list :enabled (if (enabled-p) t :json-false)
                     :file (state-file)
                     :sessions (hive-mcp-cider-sessions-count-sessions)
                     :last_error hive-mcp-cider-spawnwatch--last-error)))
