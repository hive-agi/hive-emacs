(ns hive-mcp-cider-eval-test
  "ERT tests for the CIDER async eval state machine (hive-mcp-cider-eval).

Authored in cljel (dogfoods the compiler) and run against the SHIPPED compiled
module elisp/hive-mcp-cider-eval.el.

Run:
  emacs -batch -L elisp -L src/cljel/hive_mcp/addons/cider \\
        -l ert -l eval_test.el -f ert-run-tests-batch-and-exit

Each nREPL response is mocked as a string-keyed alist of (key . value) conses;
apply-response is pure w.r.t. its ST vector, so the machine is driven with no
live nREPL. ST layout is [value err out compiled state]."
  (:require [cl-lib]))

(require 'ert)
(require 'hive-mcp-cider-eval)

;; ============================================================================
;; Mock: nrepl-dict-get over a plain (key . value) alist
;; ============================================================================

(defvar nrepl-request-counter 0
  "Test stand-in for nREPL's per-connection request counter.")

(defun nrepl-dict-get (d k)
  "Test shim: look up string key K in alist D of (key . value) conses."
  (let [hit nil
        cur d]
    (while (and cur (not hit))
      (when (equal (car (car cur)) k)
        (setq hit (car cur)))
      (setq cur (cdr cur)))
    (cdr hit)))

;; ============================================================================
;; make-eval-state
;; ============================================================================

(ert-deftest hive-mcp-cider-eval-test-make-eval-state-fresh nil
  "A fresh eval-state is a 5-slot all-nil vector."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (should (= 5 (length st)))
    (should-not (aref st 0))
    (should-not (aref st 1))
    (should-not (aref st 2))
    (should-not (aref st 3))
    (should-not (aref st 4))))

;; ============================================================================
;; apply-response — folding nREPL responses into the state vector
;; ============================================================================

(ert-deftest hive-mcp-cider-eval-test-apply-value-and-done nil
  "A value + done status lands in slot 0 and marks the state done (non-error)."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response
     st (list (cons "value" "42") (cons "status" (list "done"))))
    (should (equal "42" (aref st 0)))
    (should (aref st 4))
    (should-not (eq (aref st 4) 'error))))

(ert-deftest hive-mcp-cider-eval-test-apply-accumulates-out nil
  "stdout chunks accumulate across responses (str-concat into slot 2)."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response st (list (cons "out" "foo")))
    (hive-mcp-cider-eval-apply-response
     st (list (cons "out" "bar") (cons "status" (list "done"))))
    (should (equal "foobar" (aref st 2)))
    (should (aref st 4))))

(ert-deftest hive-mcp-cider-eval-test-apply-stderr-is-not-error nil
  "A plain stderr write with a done status is SUCCESS, not an eval error."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response
     st (list (cons "err" "a warning") (cons "status" (list "done"))))
    (should (equal "a warning" (aref st 1)))
    (should (aref st 4))
    (should-not (eq (aref st 4) 'error))))

(ert-deftest hive-mcp-cider-eval-test-apply-eval-error-status nil
  "An \"eval-error\" status marks the state 'error."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response
     st (list (cons "err" "boom") (cons "status" (list "eval-error" "done"))))
    (should (eq (aref st 4) 'error))))

(ert-deftest hive-mcp-cider-eval-test-apply-ex-is-error nil
  "An ex field marks the state 'error even without eval-error status."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response
     st (list (cons "ex" "CompilerException")
              (cons "status" (list "done"))))
    (should (eq (aref st 4) 'error))))

(ert-deftest hive-mcp-cider-eval-test-apply-root-ex-is-error nil
  "A root-ex field marks the state 'error and supplies fallback error text."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response
     st (list (cons "root-ex" "ArithmeticException")
              (cons "status" (list "done"))))
    (should (eq (aref st 4) 'error))
    (should (equal "ArithmeticException"
                   (hive-mcp-cider-eval-finalize-eval-state st)))))

(ert-deftest hive-mcp-cider-eval-test-apply-stderr-value-order-independent nil
  "Successful stderr and value chunks preserve the value in either order."
  (let [err-first (hive-mcp-cider-eval-make-eval-state)
        value-first (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response err-first (list (cons "err" "warning")))
    (hive-mcp-cider-eval-apply-response
     err-first (list (cons "value" "42") (cons "status" (list "done"))))
    (hive-mcp-cider-eval-apply-response value-first (list (cons "value" "42")))
    (hive-mcp-cider-eval-apply-response
     value-first (list (cons "err" "warning") (cons "status" (list "done"))))
    (should (equal "42" (hive-mcp-cider-eval-finalize-eval-state err-first)))
    (should (equal "42" (hive-mcp-cider-eval-finalize-eval-state value-first)))))

(ert-deftest hive-mcp-cider-eval-test-apply-captures-compiled nil
  "A cljel-active session returns its result under cljel-compiled-elisp (slot 3)."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response
     st (list (cons "cljel-compiled-elisp" "(+ 1 2)") (cons "status" (list "done"))))
    (should (equal "(+ 1 2)" (aref st 3)))
    (should (aref st 4))))

;; ============================================================================
;; finalize-eval-state — turning a completed state into the result string
;; ============================================================================

(ert-deftest hive-mcp-cider-eval-test-finalize-plain-value nil
  "A plain clj value finalizes to itself."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response
     st (list (cons "value" "99") (cons "status" (list "done"))))
    (should (equal "99" (hive-mcp-cider-eval-finalize-eval-state st)))))

(ert-deftest hive-mcp-cider-eval-test-finalize-prepends-stdout nil
  "value + accumulated stdout finalizes to out-then-value."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response st (list (cons "out" "log:")))
    (hive-mcp-cider-eval-apply-response
     st (list (cons "value" "7") (cons "status" (list "done"))))
    (should (equal "log:7" (hive-mcp-cider-eval-finalize-eval-state st)))))

(ert-deftest hive-mcp-cider-eval-test-finalize-error-returns-stderr nil
  "An error state finalizes to the accumulated stderr."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response
     st (list (cons "err" "boom") (cons "status" (list "eval-error" "done"))))
    (should (equal "boom" (hive-mcp-cider-eval-finalize-eval-state st)))))

(ert-deftest hive-mcp-cider-eval-test-finalize-out-only nil
  "stdout with no value finalizes to the stdout."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response
     st (list (cons "out" "printed") (cons "status" (list "done"))))
    (should (equal "printed" (hive-mcp-cider-eval-finalize-eval-state st)))))

(ert-deftest hive-mcp-cider-eval-test-finalize-empty-is-nil-string nil
  "A bare done with no value/out/compiled finalizes to the string \"nil\"."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response st (list (cons "status" (list "done"))))
    (should (equal "nil" (hive-mcp-cider-eval-finalize-eval-state st)))))

;; --- The P0 regression: cljel-active result must EXECUTE locally, not be "nil" ---

(ert-deftest hive-mcp-cider-eval-test-finalize-compiled-executes-locally nil
  "cljel-compiled-elisp is executed in Emacs and its result returned."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response
     st (list (cons "cljel-compiled-elisp" "(+ 1 2)") (cons "status" (list "done"))))
    (should (equal "3" (hive-mcp-cider-eval-finalize-eval-state st)))))

(ert-deftest hive-mcp-cider-eval-test-finalize-compiled-side-effect nil
  "Compiled Elisp executes side effects and returns the resulting value."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (setq hive-mcp-cider-eval-test--probe nil)
    (hive-mcp-cider-eval-apply-response
     st (list (cons "cljel-compiled-elisp"
                    "(setq hive-mcp-cider-eval-test--probe 42)")
              (cons "status" (list "done"))))
    (should (equal "42" (hive-mcp-cider-eval-finalize-eval-state st)))
    (should (equal 42 hive-mcp-cider-eval-test--probe))))

(ert-deftest hive-mcp-cider-eval-test-finalize-executes-trailing-forms nil
  "The fallback executor runs every compiled form and returns the last value."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (setq hive-mcp-cider-eval-test--probe nil)
    (hive-mcp-cider-eval-apply-response
     st (list (cons "cljel-compiled-elisp"
                    "(+ 1 2) (setq hive-mcp-cider-eval-test--probe 99)")
              (cons "status" (list "done"))))
    (should (equal "99" (hive-mcp-cider-eval-finalize-eval-state st)))
    (should (equal 99 hive-mcp-cider-eval-test--probe))))

(ert-deftest hive-mcp-cider-eval-test-finalize-installs-whole-buffer nil
  "A whole-buffer load-file payload installs namespaced defuns, a keymap and
its trailing provide; the result is the last form's value."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (fmakunbound 'hive-mcp-cider-eval-test-buf-bump)
    (fmakunbound 'hive-mcp-cider-eval-test-buf--double)
    (makunbound 'hive-mcp-cider-eval-test-buf-map)
    (setq features (delq 'hive-mcp-cider-eval-test-buf features))
    (hive-mcp-cider-eval-apply-response
     st (list (cons "cljel-compiled-elisp"
                    (elisp-concat
                     "(defvar hive-mcp-cider-eval-test-buf-counter 0)\n"
                     "(defun hive-mcp-cider-eval-test-buf--double (x) (* x 2))\n"
                     "(defun hive-mcp-cider-eval-test-buf-bump (n)\n"
                     "  (hive-mcp-cider-eval-test-buf--double n))\n"
                     "(defvar hive-mcp-cider-eval-test-buf-map\n"
                     "  (let* ((m (make-sparse-keymap)))\n"
                     "    (define-key m (kbd \"C-c C-b\")"
                     " 'hive-mcp-cider-eval-test-buf-bump)\n"
                     "    m))\n"
                     "(provide 'hive-mcp-cider-eval-test-buf)\n"))
              (cons "status" (list "done"))))
    (should (equal "hive-mcp-cider-eval-test-buf"
                   (hive-mcp-cider-eval-finalize-eval-state st)))
    (should (featurep 'hive-mcp-cider-eval-test-buf))
    (should (fboundp 'hive-mcp-cider-eval-test-buf--double))
    (should (equal 14 (hive-mcp-cider-eval-test-buf-bump 7)))
    (should (keymapp hive-mcp-cider-eval-test-buf-map))
    (should (eq 'hive-mcp-cider-eval-test-buf-bump
                (lookup-key hive-mcp-cider-eval-test-buf-map (kbd "C-c C-b"))))))

(ert-deftest hive-mcp-cider-eval-test-finalize-single-form-unchanged nil
  "A single-form payload still yields that form's value."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response
     st (list (cons "cljel-compiled-elisp" "(* 6 7)")
              (cons "status" (list "done"))))
    (should (equal "42" (hive-mcp-cider-eval-finalize-eval-state st)))))

(ert-deftest hive-mcp-cider-eval-test-finalize-rejects-non-string nil
  "The compiled payload must be a string."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (aset st 3 42)
    (aset st 4 t)
    (should (string-match-p
             "Invalid compiled Elisp payload"
             (hive-mcp-cider-eval-finalize-eval-state st)))))

(ert-deftest hive-mcp-cider-eval-test-finalize-compile-error-wins nil
  "An eval error returns stderr without executing a compiled payload."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (setq hive-mcp-cider-eval-test--probe nil)
    (hive-mcp-cider-eval-apply-response
     st (list (cons "cljel-compiled-elisp"
                    "(setq hive-mcp-cider-eval-test--probe 99)")
              (cons "err" "Compilation error")
              (cons "status" (list "eval-error" "done"))))
    (should (equal "Compilation error"
                   (hive-mcp-cider-eval-finalize-eval-state st)))
    (should-not hive-mcp-cider-eval-test--probe)))

(ert-deftest hive-mcp-cider-eval-test-finalize-multi-chunk-stdout nil
  "Multiple stdout chunks precede the final value without truncation."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response st (list (cons "out" "a")))
    (hive-mcp-cider-eval-apply-response st (list (cons "out" "b")))
    (hive-mcp-cider-eval-apply-response
     st (list (cons "value" "nil") (cons "status" (list "done"))))
    (should (equal "abnil" (hive-mcp-cider-eval-finalize-eval-state st)))))

(ert-deftest hive-mcp-cider-eval-test-finalize-compiled-delegates-to-helper nil
  "When the cider-cljel client helper is bound, finalize delegates to it."
  (let [st (hive-mcp-cider-eval-make-eval-state)]
    (hive-mcp-cider-eval-apply-response
     st (list (cons "cljel-compiled-elisp" "(ignored)") (cons "status" (list "done"))))
    (cl-letf (((symbol-function 'cider-cljel--eval-elisp-string)
               (lambda (s) (format "DELEGATED:%s" s))))
      (should (equal "DELEGATED:(ignored)"
                     (hive-mcp-cider-eval-finalize-eval-state st))))))

;; ============================================================================
;; eval-in-session — registry state must agree with the Emacs buffer lifecycle
;; ============================================================================

(ert-deftest hive-mcp-cider-eval-test-session-dead-buffer-demotes nil
  "A connected session with no live REPL buffer becomes stale and errors clearly."
  (let [demoted nil
        message nil]
    (cl-letf (((symbol-function 'hive-mcp-cider-sessions-lookup)
               (lambda (_name)
                 (list :status 'connected :cider-buffer " *gone-repl*")))
              ((symbol-function 'hive-mcp-cider-sessions-update-prop)
               (lambda (name key value)
                 (setq demoted (list name key value)))))
      (condition-case e
          (hive-mcp-cider-eval-eval-in-session "dead" "(+ 1 2)")
        (error (setq message (error-message-string e))))
      (should (string-match-p "Session .*dead.* REPL buffer is gone" message))
      (should (equal (list "dead" :status 'stale) demoted)))))

(ert-deftest hive-mcp-cider-eval-test-session-live-buffer-evaluates nil
  "A live session evaluates inside its registered REPL buffer."
  (let [buf (generate-new-buffer " *live-repl*")]
    (unwind-protect
        (cl-letf (((symbol-function 'hive-mcp-cider-sessions-lookup)
                   (lambda (_name)
                     (list :status 'connected :cider-buffer buf)))
                  ((symbol-function 'hive-mcp-cider-eval-eval-with-heartbeat)
                   (lambda (code timeout)
                     (list code timeout (eq (current-buffer) buf)))))
          (should (equal (list "(+ 1 2)" 7 t)
                         (hive-mcp-cider-eval-eval-in-session
                          "live" "(+ 1 2)" 7))))
      (kill-buffer buf))))

;; ============================================================================
;; Session readiness — status, :reason and the cljel upgrade assertion
;; ============================================================================

(ert-deftest hive-mcp-cider-eval-test-not-connected-message-carries-reason nil
  "A registry :reason is surfaced with the status instead of being dropped."
  (should (equal "Session 'a' not connected (status: connecting)"
                 (hive-mcp-cider-eval-not-connected-message
                  "a" (list :status 'connecting))))
  (should (string-match-p
           "status: error).*port 7910: handshake never completed"
           (hive-mcp-cider-eval-not-connected-message
            "a" (list :status 'error
                      :reason "port 7910: handshake never completed")))))

(ert-deftest hive-mcp-cider-eval-test-cljel-upgrade-failed-p nil
  "Only a cljel-typed session with a failed upgrade is broken."
  (should (hive-mcp-cider-eval-cljel-upgrade-failed-p
           (list :repl-type 'cljel :cljel-upgrade 'failed)))
  (should-not (hive-mcp-cider-eval-cljel-upgrade-failed-p
               (list :repl-type 'cljel :cljel-upgrade 'confirmed)))
  (should-not (hive-mcp-cider-eval-cljel-upgrade-failed-p
               (list :repl-type 'clj :cljel-upgrade 'failed)))
  (should-not (hive-mcp-cider-eval-cljel-upgrade-failed-p (list :repl-type 'cljel))))

(ert-deftest hive-mcp-cider-eval-test-session-connecting-reports-reason nil
  "eval-in-session refuses a handshake-in-flight session and says why."
  (let [message nil]
    (cl-letf (((symbol-function 'hive-mcp-cider-sessions-lookup)
               (lambda (_name)
                 (list :status 'connecting :reason "port 7922: handshake in flight"))))
      (condition-case e
          (hive-mcp-cider-eval-eval-in-session "pending" "(+ 1 2)")
        (error (setq message (error-message-string e)))))
    (should (string-match-p "status: connecting" message))
    (should (string-match-p "handshake in flight" message))))

(ert-deftest hive-mcp-cider-eval-test-session-failed-cljel-upgrade-refused nil
  "A cljel session whose upgrade failed is refused before any eval is sent."
  (let [message nil]
    (cl-letf (((symbol-function 'hive-mcp-cider-sessions-lookup)
               (lambda (_name)
                 (list :status 'connected :repl-type 'cljel
                       :cljel-upgrade 'failed :cider-buffer " *repl*"))))
      (condition-case e
          (hive-mcp-cider-eval-eval-in-session "half-cljel" "(message \"hi\")")
        (error (setq message (error-message-string e)))))
    (should (string-match-p "never upgraded to cljel" message))))

(ert-deftest hive-mcp-cider-eval-test-connect-failure-reports-diagnosis nil
  "eval-silent surfaces the connectivity diagnosis, not a generic message."
  (let [message nil]
    (cl-letf (((symbol-function 'hive-mcp-cider-connection-ensure-connected)
               (lambda () nil))
              ((symbol-function 'hive-mcp-cider-connection-describe-connectivity)
               (lambda () "port 7910: nREPL never completed the CIDER handshake")))
      (condition-case e
          (hive-mcp-cider-eval-eval-silent "(+ 1 2)")
        (error (setq message (error-message-string e)))))
    (should (string-match-p "never completed the CIDER handshake" message))))

;; ============================================================================
;; wrap-compiled-callback — the shared compiled-elisp routing helper
;; ============================================================================

(ert-deftest hive-mcp-cider-eval-test-wrap-passes-plain-response-through nil
  "A response with no compiled payload reaches the delegate unchanged."
  (let [seen nil
        cb (hive-mcp-cider-eval-wrap-compiled-callback
             (lambda (response) (setq seen response)))
        response (list (cons "value" "42") (cons "status" (list "done")))]
    (funcall cb response)
    (should (eq response seen))))

(ert-deftest hive-mcp-cider-eval-test-wrap-executes-compiled-then-delegates nil
  "A compiled payload is executed in Emacs before the delegate is called."
  (let [seen nil
        cb (hive-mcp-cider-eval-wrap-compiled-callback
             (lambda (response) (setq seen response)))]
    (setq hive-mcp-cider-eval-test--probe nil)
    (funcall cb (list (cons "cljel-compiled-elisp"
                            "(setq hive-mcp-cider-eval-test--probe 7)")
                      (cons "status" (list "done"))))
    (should (equal 7 hive-mcp-cider-eval-test--probe))
    (should seen)))

(ert-deftest hive-mcp-cider-eval-test-wrap-attaches-value-to-dict nil
  "On a real nREPL dict the local result is attached as \"value\"."
  (let [put nil
        cb (hive-mcp-cider-eval-wrap-compiled-callback (lambda (_response) nil))]
    (cl-letf (((symbol-function 'nrepl-dict-p) (lambda (_d) t))
              ((symbol-function 'nrepl-dict-put)
               (lambda (d k v) (setq put (list k v)) d)))
      (funcall cb (list (cons "cljel-compiled-elisp" "(+ 20 22)")
                        (cons "status" (list "done")))))
    (should (equal (list "value" "42") put))))

(ert-deftest hive-mcp-cider-eval-test-wrap-without-callback-still-executes nil
  "A nil delegate still runs the compiled payload."
  (let [cb (hive-mcp-cider-eval-wrap-compiled-callback nil)]
    (setq hive-mcp-cider-eval-test--probe nil)
    (funcall cb (list (cons "cljel-compiled-elisp"
                            "(setq hive-mcp-cider-eval-test--probe 5)")
                      (cons "status" (list "done"))))
    (should (equal 5 hive-mcp-cider-eval-test--probe))))

(ert-deftest hive-mcp-cider-eval-test-explicit-routes-compiled-elisp nil
  "eval-explicit runs a cljel session's compiled Elisp instead of no-opping."
  (let [reply nil]
    (setq hive-mcp-cider-eval-test--probe nil)
    (cl-letf (((symbol-function 'hive-mcp-cider-connection-ensure-connected)
               (lambda () t))
              ((symbol-function 'cider-interactive-eval)
               (lambda (_code callback)
                 (funcall callback
                          (list (cons "cljel-compiled-elisp"
                                      "(setq hive-mcp-cider-eval-test--probe 11)")
                                (cons "status" (list "done")))))))
      (setq reply (hive-mcp-cider-eval-eval-explicit "(setq x 11)")))
    (should (equal 11 hive-mcp-cider-eval-test--probe))
    (should (string-prefix-p "Sent to REPL:" reply))))

;; ============================================================================
;; eval-with-heartbeat — timeout must interrupt the server-side eval
;; ============================================================================

(ert-deftest hive-mcp-cider-eval-test-timeout-interrupts-observed-id nil
  "A timed-out eval interrupts the request id observed in the responses."
  (let [conn (generate-new-buffer " *conn-observed*")
        interrupts nil
        message nil]
    (unwind-protect
        (cl-letf (((symbol-function 'cider-current-repl) (lambda (&rest _) conn))
                  ((symbol-function 'cider-nrepl-request:eval)
                   (lambda (_code callback)
                     (funcall callback (list (cons "id" "42")))))
                  ((symbol-function 'nrepl-request:interrupt)
                   (lambda (id _callback connection)
                     (setq interrupts (cons (list id connection) interrupts)))))
          (condition-case e
              (hive-mcp-cider-eval-eval-with-heartbeat "(Thread/sleep 100000)" 0.2)
            (error (setq message (error-message-string e)))))
      (kill-buffer conn))
    (should (string-match-p "Eval timed out after 0.2 seconds" message))
    (should (string-match-p "server interrupt sent" message))
    (should (equal 1 (length interrupts)))
    (should (equal "42" (car (car interrupts))))))

(ert-deftest hive-mcp-cider-eval-test-timeout-falls-back-to-connection-id nil
  "With no response at all the interrupt uses the connection's last request id."
  (let [conn (generate-new-buffer " *conn-counter*")
        interrupts nil]
    (with-current-buffer conn
      (make-local-variable 'nrepl-request-counter)
      (setq nrepl-request-counter 7))
    (unwind-protect
        (cl-letf (((symbol-function 'cider-current-repl) (lambda (&rest _) conn))
                  ((symbol-function 'cider-nrepl-request:eval)
                   (lambda (_code _callback) nil))
                  ((symbol-function 'nrepl-request:interrupt)
                   (lambda (id _callback _connection)
                     (setq interrupts (cons id interrupts)))))
          (should-error
           (hive-mcp-cider-eval-eval-with-heartbeat "(loop)" 0.2)))
      (kill-buffer conn))
    (should (equal (list "7") interrupts))))

(ert-deftest hive-mcp-cider-eval-test-completed-eval-sends-no-interrupt nil
  "A completed eval returns its value and never interrupts."
  (let [conn (generate-new-buffer " *conn-done*")
        interrupts 0
        result nil]
    (unwind-protect
        (cl-letf (((symbol-function 'cider-current-repl) (lambda (&rest _) conn))
                  ((symbol-function 'cider-nrepl-request:eval)
                   (lambda (_code callback)
                     (funcall callback (list (cons "id" "3")
                                             (cons "value" "42")
                                             (cons "status" (list "done"))))))
                  ((symbol-function 'nrepl-request:interrupt)
                   (lambda (&rest _) (setq interrupts (1+ interrupts)))))
          (setq result (hive-mcp-cider-eval-eval-with-heartbeat "(+ 40 2)" 5)))
      (kill-buffer conn))
    (should (equal "42" result))
    (should (equal 0 interrupts))))

;; ============================================================================
;; splice-forms — the cljw top-level `do` workaround
;; ============================================================================

(ert-deftest hive-mcp-cider-eval-test-splice-cljw-do nil
  "A cljw session's top-level `do' is split into one string per child.
cljw analyses a whole form before running any of it, so a `require' and its
first use inside one `do' fail there while working via `cljw -e'."
  (let [spliced (hive-mcp-cider-eval-splice-forms "(do (require 'x) (f 1))" 'cljw)]
    (should (equal 2 (length spliced)))
    (should (equal "(require 'x)" (nth spliced 0)))
    ;; The LAST child is the `do' form's value, so it must be sent last.
    (should (equal "(f 1)" (nth spliced 1)))))

(ert-deftest hive-mcp-cider-eval-test-splice-leaves-other-runtimes-alone nil
  "Only cljw is spliced; every other runtime evaluates the `do' as written."
  (let [code "(do (setq a 1) (+ a 1))"]
    (dolist (rt (list 'clj 'cljs 'cljel 'cljrs nil))
      (should (equal (list code) (hive-mcp-cider-eval-splice-forms code rt))))))

(ert-deftest hive-mcp-cider-eval-test-splice-leaves-non-do-alone nil
  "A cljw session splices only a top-level `do'; anything else is untouched."
  (dolist (code (list "(+ 1 2)" "(let ((x 1)) x)" "(do)"))
    (should (equal (list code) (hive-mcp-cider-eval-splice-forms code 'cljw)))))

(ert-deftest hive-mcp-cider-eval-test-splice-refuses-trailing-forms nil
  "Several top-level forms are not one `do' — splicing them would drop code."
  (let [code "(do (setq a 1)) (+ 1 2)"]
    (should (equal (list code) (hive-mcp-cider-eval-splice-forms code 'cljw)))))

(ert-deftest hive-mcp-cider-eval-test-splice-survives-unreadable-code nil
  "Unbalanced input is sent as-is so the runtime reports the read error."
  (let [code "(do (foo"]
    (should (equal (list code) (hive-mcp-cider-eval-splice-forms code 'cljw)))))

;; ============================================================================
;; Runner
;; ============================================================================

(defn run-tests []
  "Run all hive-mcp-cider-eval ERT tests in batch."
  (interactive)
  (ert-run-tests-batch-and-exit "^hive-mcp-cider-eval-test-"))
