    (hive-mcp-cider-nrepl-build-command 'cljw 7920))))
    (should (equal "nrepl" (car (cdr cmd))))
    (should (member "7920" cmd))
    (should (equal '("-cp" "src:test") (cdr (cdr (cdr (cdr cmd))))))
    (should-not (member "--src-path" cmd))))

(ert-deftest hive-mcp-cider-nrepl-test-cljw-classpath-unsupported-warns nil "A cljw with no classpath mechanism drops the roots and says so.\nThe argv carries no -cp — a build without the fix exits 1 on one — and the\nplan carries a :classpath-unsupported diagnostic naming the roots, so a\nclasspath-less launch is announced rather than silently accepted." (let* ((plan (let* ((hive-mcp-cider-nrepl-cljw-binary "/tmp/cljw")
        (hive-mcp-cider-runtime-cljw-classpath :none)
        (hive-mcp-cider-nrepl-native-source-roots '("src" "test")))
    (hive-mcp-cider-nrepl-launch-plan 'cljw 7920))))
    (should (equal 4 (length (plist-get plan :command))))
    (should-not (member "-cp" (plist-get plan :command)))
    (let* ((diag (car (plist-get plan :diagnostics))))
    (should (eq :warn (plist-get diag :level)))
    (should (eq :classpath-unsupported (plist-get diag :code)))
    (should (string-match-p "src test" (plist-get diag :message))))))

(ert-deftest hive-mcp-cider-nrepl-test-build-command-cljw-no-roots-no-cp nil "With no configured source roots the cljw branch emits no -cp at all.\nAn empty -cp would otherwise shadow $CLJW_PATH and the ./deps.edn :paths\nfallback, which are the other two rungs of cljw's own classpath resolution.\nNothing is reported either — there were no roots to drop." (let* ((plan (let* ((hive-mcp-cider-nrepl-cljw-binary "/tmp/cljw")
