(ert-deftest hive-mcp-cider-nrepl-test-build-command-cljw-classpath nil "A cljw resolved as accepting -cp receives the roots colon-joined.\nThe transport is resolved rather than assumed: setting\n`hive-mcp-cider-runtime-cljw-classpath' answers the top rung of the chain,\nso no binary is probed. cljw's nrepl subcommand takes a single -cp of\ncolon-separated dirs, unlike cljrs's repeated --src-path." (let* ((cmd (let* ((hive-mcp-cider-nrepl-cljw-binary "/tmp/cljw")
        (hive-mcp-cider-runtime-cljw-classpath :cp)
