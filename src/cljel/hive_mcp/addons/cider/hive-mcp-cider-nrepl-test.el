    (hive-mcp-cider-nrepl-build-command 'cljel 7999 nil '("dev"))))
        (sdeps (clel-nth cmd 2)))
    (should (member "-M:dev" cmd))
    (should (string-match-p ":main-opts" sdeps))))

(ert-deftest hive-mcp-cider-nrepl-test-build-command-per-spawn-aliases-override nil "A per-spawn ALIASES argument overrides the launch-aliases defcustom." (let* ((cmd (let* ((hive-mcp-cider-nrepl-launch-aliases nil))
    (hive-mcp-cider-nrepl-build-command 'clj 7999 nil '("test")))))
    (should (member "-M:test" cmd))
    (should-not (member "-M" cmd))))

(ert-deftest hive-mcp-cider-nrepl-test-launch-process-forwards-extra-args nil "launch-process forwards EXTRA-ARGS and ALIASES into the spawned argv." (let* ((dir (make-temp-file "hive-mcp-cider-nrepl-test" t))
        (captured nil))
    (unwind-protect
    (cl-letf (((symbol-function 'start-process) (lambda (name buffer &rest cmd)
    (setq captured cmd)
    'stub-process))) (should (eq 'stub-process (hive-mcp-cider-nrepl-launch-process "s" 7999 'clj dir '("-Sdeps" "{:deps {}}") '("test")))) (should (member "{:deps {}}" captured)) (should (member "-M:test" captured)))
  (delete-directory dir t))))

(ert-deftest hive-mcp-cider-nrepl-test-oom-guard-wraps-on-linux nil "On gnu/linux the argv is prefixed by a sh -c that writes the score to\n/proc/self/oom_score_adj and then execs the untouched original argv." (let* ((cmd (hive-mcp-cider-nrepl-oom-guard-command '("clojure" "-M" "a b") 500 'gnu/linux)))
    (should (equal '("sh" "-c") (list (car cmd) (car (cdr cmd)))))
    (should (string-match-p "echo 500 > /proc/self/oom_score_adj" (clel-nth cmd 2)))
    (should (string-match-p "exec \"\\$0\" \"\\$@\"" (clel-nth cmd 2)))
    (should (equal '("clojure" "-M" "a b") (cdr (cdr (cdr cmd)))))))

(ert-deftest hive-mcp-cider-nrepl-test-oom-guard-defaults-to-defcustom nil "Without ADJ the defcustom value is written." (let* ((cmd (let* ((hive-mcp-cider-nrepl-oom-score-adj 700))
    (hive-mcp-cider-nrepl-oom-guard-command '("clojure") nil 'gnu/linux))))
    (should (string-match-p "echo 700 " (clel-nth cmd 2)))))

(ert-deftest hive-mcp-cider-nrepl-test-oom-guard-degrades-silently nil "Off Linux, disabled, or out of range, the argv is returned unchanged." (let* ((argv '("clojure" "-M")))
    (should (equal argv (hive-mcp-cider-nrepl-oom-guard-command argv 500 'darwin)))
    (should (equal argv (hive-mcp-cider-nrepl-oom-guard-command argv 500 'windows-nt)))
    (should (equal argv (let* ((hive-mcp-cider-nrepl-oom-score-adj nil))
    (hive-mcp-cider-nrepl-oom-guard-command argv nil 'gnu/linux))))
    (should (equal argv (hive-mcp-cider-nrepl-oom-guard-command argv 1001 'gnu/linux)))
    (should (equal argv (hive-mcp-cider-nrepl-oom-guard-command argv -100 'gnu/linux)))
    (should-not (hive-mcp-cider-nrepl-oom-guard-command nil 500 'gnu/linux))))

(ert-deftest hive-mcp-cider-nrepl-test-launch-process-goes-through-port nil "launch-process starts its JVM through the process port, wrapped by the\nOOM guard, so the recording stub sees sh -c ... followed by the clojure argv." (let* ((dir (make-temp-file "hive-mcp-cider-nrepl-test" t))
        (calls nil))
    (unwind-protect
    (let* ((hive-mcp-cider-nrepl-process-spawner (lambda (name buffer &rest cmd)
    (setq calls (cons (list name buffer cmd) calls))
    'stub-process))
        (hive-mcp-cider-nrepl-oom-score-adj 500)
        (system-type 'gnu/linux)
        (hive-mcp-cider-nrepl-local-deps-files nil)
        (hive-mcp-cider-nrepl-launch-aliases nil))
    (should (eq 'stub-process (hive-mcp-cider-nrepl-launch-process "s" 7999 'clj dir)))
    (should (equal 1 (length calls)))
    (let* ((cmd (clel-nth (car calls) 2)))
    (should (equal "nrepl-s" (car (car calls))))
    (should (equal "sh" (car cmd)))
    (should (string-match-p "oom_score_adj" (clel-nth cmd 2)))
    (should (equal "clojure" (clel-nth cmd 3)))
    (should (member "nrepl.cmdline" cmd))))
  (delete-directory dir t))))

(ert-deftest hive-mcp-cider-nrepl-test-start-default-goes-through-port nil "The default server is spawned through the same guarded port." (let* ((dir (make-temp-file "hive-mcp-cider-nrepl-test" t))
        (captured nil))
    (unwind-protect
    (let* ((hive-mcp-cider-nrepl-process-spawner (lambda (name buffer &rest cmd)
    (setq captured (cons name cmd))
    'stub-process))
        (hive-mcp-cider-nrepl--default-process nil)
        (hive-mcp-cider-nrepl-oom-score-adj 500)
        (system-type 'gnu/linux)
        (hive-mcp-cider-nrepl-local-deps-files nil))
    (should (eq 'stub-process (hive-mcp-cider-nrepl-start-default dir)))
    (should (equal "nrepl-server" (car captured)))
    (should (equal "sh" (car (cdr captured))))
    (should (member "clojure" captured)))
  (delete-directory dir t))))

(ert-deftest hive-mcp-cider-nrepl-test-oom-guard-shell-command-wraps-on-linux nil "A jack-in shell-command string becomes sh -c <guard> sh -c <cmd>, every\nword shell-quoted, so the guard writes the score and execs the original\ncommand line unchanged." (let* ((cmd "clojure -Sdeps '{:deps {}}' -M:dev -m nrepl.cmdline")
        (wrapped (hive-mcp-cider-nrepl-oom-guard-shell-command cmd 500 'gnu/linux)))
    (should (string-prefix-p "sh -c " wrapped))
    (should (string-match-p "oom_score_adj" wrapped))
    (should (string-match-p (regexp-quote (shell-quote-argument cmd)) wrapped))
    (should (equal (mapconcat #'shell-quote-argument (hive-mcp-cider-nrepl-oom-guard-command (list "sh" "-c" cmd) 500 'gnu/linux) " ") wrapped))))

(ert-deftest hive-mcp-cider-nrepl-test-oom-guard-shell-command-degrades nil "Off Linux, disabled, empty or non-string, the command is returned unchanged." (let* ((cmd "clojure -M:dev"))
    (should (equal cmd (hive-mcp-cider-nrepl-oom-guard-shell-command cmd 500 'darwin)))
    (should (equal cmd (let* ((hive-mcp-cider-nrepl-oom-score-adj nil))
    (hive-mcp-cider-nrepl-oom-guard-shell-command cmd nil 'gnu/linux))))
    (should (equal cmd (hive-mcp-cider-nrepl-oom-guard-shell-command cmd 2000 'gnu/linux)))
    (should (equal "" (hive-mcp-cider-nrepl-oom-guard-shell-command "" 500 'gnu/linux)))
    (should-not (hive-mcp-cider-nrepl-oom-guard-shell-command nil 500 'gnu/linux))))

(defvar hive-mcp-cider-nrepl-test--jack-in-calls nil
  "Calls recorded by `hive-mcp-cider-nrepl-test--jack-in-port'.")

(defun hive-mcp-cider-nrepl-test--jack-in-port (directory cmd on-port) "Recording stub with the signature of `nrepl-start-server-process'." (setq hive-mcp-cider-nrepl-test--jack-in-calls (cons (list directory cmd on-port) hive-mcp-cider-nrepl-test--jack-in-calls)) 'stub-server)

(ert-deftest hive-mcp-cider-nrepl-test-jack-in-guard-through-port nil "Installed on the jack-in process port, the guard rewrites only CMD; the\ndirectory and callback reach the port untouched, and uninstall restores the\nbare command." (let* ((hive-mcp-cider-nrepl-test--jack-in-calls nil)
        (hive-mcp-cider-nrepl-jack-in-guard-target 'hive-mcp-cider-nrepl-test--jack-in-port)
        (hive-mcp-cider-nrepl-oom-score-adj 500)
        (system-type 'gnu/linux)
        (cb (lambda (_)
    nil)))
    (unwind-protect
    (progn
  (hive-mcp-cider-nrepl-install-jack-in-guard)
  (hive-mcp-cider-nrepl-install-jack-in-guard)
  (should (eq 'stub-server (hive-mcp-cider-nrepl-test--jack-in-port "/proj/" "clojure -M:dev" cb)))
  (let* ((call (car hive-mcp-cider-nrepl-test--jack-in-calls)))
    (should (equal "/proj/" (car call)))
    (should (eq cb (clel-nth call 2)))
    (should (string-prefix-p "sh -c " (clel-nth call 1)))
    (should (string-match-p "oom_score_adj" (clel-nth call 1)))
    (should-not (string-match-p "oom_score_adj.*oom_score_adj" (clel-nth call 1)))))
  (hive-mcp-cider-nrepl-uninstall-jack-in-guard))
    (hive-mcp-cider-nrepl-test--jack-in-port "/proj/" "clojure -M:dev" cb)
    (should (equal "clojure -M:dev" (clel-nth (car hive-mcp-cider-nrepl-test--jack-in-calls) 1)))))

