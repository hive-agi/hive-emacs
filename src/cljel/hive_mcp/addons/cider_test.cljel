(ns hive-mcp-cider-test
  "ERT contract tests for the hive-mcp-cider facade — session lifecycle guards."
  (:require [cl-lib]))

(require 'ert)
(require 'transient)
(require 'hive-mcp-cider)

(ert-deftest hive-mcp-cider-test-kill-session-unknown-signals nil
  "Killing an unregistered session is a loud error, never a silent no-op."
  (hive-mcp-cider-sessions-clear-all)
  (unwind-protect
      (should-error (hive-mcp-cider-kill-session "no-such-session-xyz")
                    :type 'error)
    (hive-mcp-cider-sessions-clear-all)))

(ert-deftest hive-mcp-cider-test-kill-session-blank-signals nil
  "A blank or nil session name is a loud error."
  (should-error (hive-mcp-cider-kill-session "") :type 'error)
  (should-error (hive-mcp-cider-kill-session nil) :type 'error))

(ert-deftest hive-mcp-cider-test-kill-session-registered-succeeds nil
  "A registered session is killed and unregistered."
  (hive-mcp-cider-sessions-clear-all)
  (unwind-protect
      (progn
        (hive-mcp-cider-sessions-register "victim" (list :port 7999 :process nil))
        (hive-mcp-cider-kill-session "victim")
        (should (not (hive-mcp-cider-sessions-exists-p "victim"))))
    (hive-mcp-cider-sessions-clear-all)))

;; ============================================================================
;; spawn-session-from-plist: :aliases reach the launched clojure CLI argv
;; ============================================================================

(ert-deftest hive-mcp-cider-test-spawn-plist-aliases-reach-the-argv nil
  "The :aliases of a spawn request select the -M flag of the started process
and override `hive-mcp-cider-nrepl-launch-aliases'. The process is recorded,
never started; the retry timer is not armed."
  (hive-mcp-cider-sessions-clear-all)
  (let [dir (make-temp-file "hive-mcp-cider-test" t)
        argv nil]
    (unwind-protect
        (let [hive-mcp-cider-nrepl-launch-aliases '("dev")]
          (cl-letf (((symbol-function 'start-process)
                     (lambda (_name _buffer &rest cmd)
                       (setq argv cmd)
                       nil))
                    ((symbol-function 'run-with-timer)
                     (lambda (&rest _) nil))
                    ((symbol-function 'hive-mcp-cider-nrepl-port-open-p)
                     (lambda (_port) nil)))
            (hive-mcp-cider-spawn-session-from-plist
             (list :name "aliased" :repl-type 'clj :port 7991
                   :project-dir dir :aliases '("test"))))
          (should (member "-M:test" argv))
          (should-not (member "-M:dev" argv))
          (should-not (member "-M" argv))
          (should (member "nrepl.cmdline" argv))
          (should (cl-some (lambda (a) (string-match-p ":test {:main-opts \\[\\]}" a)) argv)))
      (hive-mcp-cider-sessions-clear-all)
      (delete-directory dir t))))
