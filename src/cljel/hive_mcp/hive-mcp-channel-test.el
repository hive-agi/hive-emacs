(ert-deftest hive-mcp-channel-test-default-endpoint-is-server-tcp nil "With no env override the defaults are TCP, 127.0.0.1 and 9998." (let* ((process-environment (append (list "HIVE_MCP_CHANNEL_HOST" "HIVE_MCP_CHANNEL_PORT") process-environment)))
    (should (eq 'tcp (custom--standard-value 'hive-mcp-channel-type)))
    (should (equal "127.0.0.1" (custom--standard-value 'hive-mcp-channel-host)))
    (should (equal 9998 (custom--standard-value 'hive-mcp-channel-port)))))

(ert-deftest hive-mcp-channel-test-env-overrides-endpoint nil "HIVE_MCP_CHANNEL_HOST and HIVE_MCP_CHANNEL_PORT set the defaults; an empty\nhost or a value that is not a port falls back to 127.0.0.1:9998." (let* ((process-environment (append (list "HIVE_MCP_CHANNEL_HOST=::1" "HIVE_MCP_CHANNEL_PORT=7001") process-environment)))
    (should (equal "::1" (custom--standard-value 'hive-mcp-channel-host)))
