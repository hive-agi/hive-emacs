(ert-deftest hive-mcp-channel-test-oversize-frame-then-valid-frame-delivers nil "An oversize declared length drops the buffer instead of growing it, and a\nvalid frame in a later read is delivered.  An incomplete frame whose buffered\nsize passes the limit is dropped too." (let* ((seen nil)
        (hive-mcp-channel--handlers (make-hash-table :test 'eq))
        (hive-mcp-channel--buffer nil))
    (unwind-protect
    (progn
  (hive-mcp-channel-on :ping (lambda (msg)
    (push msg seen)))
  (hive-mcp-channel--process-filter nil "99999999999:abcdef")
  (should (equal 0 (buffer-size hive-mcp-channel--buffer)))
  (hive-mcp-channel--process-filter nil "d4:type4:pinge")
  (should (equal (list (list (cons "type" "ping"))) seen))
  (should (equal 0 (buffer-size hive-mcp-channel--buffer)))
  (let* ((hive-mcp-channel-max-frame-bytes 32))
    (hive-mcp-channel--process-filter nil "l")
    (cl-dotimes (_ 20)
    (hive-mcp-channel--process-filter nil "4:pad!")
    (should (<= (buffer-size hive-mcp-channel--buffer) 32))))
  (hive-mcp-channel--process-filter nil "d4:type4:pinge")
  (should (equal 2 (length seen)))
  (should (equal 0 (buffer-size hive-mcp-channel--buffer))))
  (when (buffer-live-p hive-mcp-channel--buffer)
    (kill-buffer hive-mcp-channel--buffer)))))

