    (should (equal "127.0.0.1" (custom--standard-value 'hive-mcp-channel-host)))
    (should (equal 9998 (custom--standard-value 'hive-mcp-channel-port))))))

(ert-deftest hive-mcp-channel-test-connect-dials-tcp-by-default nil "`hive-mcp-channel-connect' with the default type opens a TCP connection to\nhost and port, never a local socket." (let* ((calls nil)
        (hive-mcp-channel--process nil)
        (hive-mcp-channel-type (custom--standard-value 'hive-mcp-channel-type))
        (hive-mcp-channel-host "127.0.0.1")
        (hive-mcp-channel-port 9998))
    (cl-letf (((symbol-function 'make-network-process) (lambda (&rest args)
    (push args calls)
    'hive-mcp-channel-test-proc))) (hive-mcp-channel-connect))
    (should (equal 1 (length calls)))
