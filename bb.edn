{:min-bb-version "1.3.0"

 :tasks
 {:requires ([babashka.fs :as fs]
             [clojure.string :as str])

  :init (do
          (def repo-root (str (fs/parent (fs/absolutize *file*))))
          ;; ERT artifacts are the *-test.el siblings build.sh writes next to their
          ;; .cljel sources; claude_code_ide is upstream and never built here.
          (defn ert-artifacts []
            (->> (fs/glob repo-root "src/cljel/**/*-test.el")
                 (map str)
                 (remove (fn [f] (str/includes? f "claude_code_ide")))
                 sort))
          ;; Third-party elisp the compiled artifacts require at load time.
          ;; Fetched pinned into .cache/elisp-vendor (gitignored) at test time —
          ;; never committed, so GPL sources stay out of the tree.
          (def elisp-test-deps
            [["https://github.com/clojure-emacs/parseclj" "v1.1.1"]
             ["https://github.com/clojure-emacs/parseedn" "v1.2.1"]])
          (def elisp-vendor-root (str (fs/path repo-root ".cache" "elisp-vendor")))
          (defn vendored-dep-dirs []
            (->> elisp-test-deps
                 (map (fn [[repo _]]
                        (str (fs/path elisp-vendor-root (fs/file-name repo)))))
                 (filter fs/directory?))))

  build
  {:doc  "Compile src/cljel/**/*.cljel to elisp/ (+ sibling ERT artifacts)."
   :task (shell {:dir repo-root} "./build.sh")}

  parity
  {:doc  "Fail if any committed .el artifact is stale w.r.t. its .cljel source."
   :task (shell {:dir repo-root} "bash" "scripts/check-cljel-parity.sh")}

  lint:nth
  {:doc  "Fail if a .cljel source calls nth with the index first (elisp order)."
   :task (shell {:dir repo-root} "bash" "scripts/check-nth-arg-order.sh")}

  test
  {:doc  "Run the Clojure test suite (self-contained: published deps only)."
   :task (shell {:dir repo-root} "clojure" "-M:test")}

  vendor:elisp-deps
  {:doc  "Fetch pinned third-party elisp test deps (parseclj/parseedn) into
          .cache/elisp-vendor (gitignored). ERT loads them via -L."
   :task (doseq [[repo tag] elisp-test-deps
                 :let [dir (str (fs/path elisp-vendor-root
                                         (fs/file-name repo)))]]
           (when-not (fs/exists? dir)
             (println "Fetching" repo tag)
             (shell "git" "clone" "--quiet" "--depth" "1"
                    "--branch" tag repo dir)))}

  ert-files
  {:doc  "List the ERT artifacts the batch runner loads, one per line."
   :task (run! println (ert-artifacts))}

  test:ert
  {:doc     "Run the addon ERT suites in a headless emacs -Q --batch process."
   :depends [vendor:elisp-deps]
   :task (let [files (ert-artifacts)
               dirs  (distinct (map (fn [f] (str (fs/parent f))) files))]
           (when (empty? files)
             (println "No ERT artifacts found under src/cljel — run `bb build` first.")
             (System/exit 1))
           (apply shell {:dir repo-root}
                  "emacs" "-Q" "--batch"
                  (concat ["-L" (str (fs/path repo-root "elisp"))]
                          (mapcat (fn [d] ["-L" d]) (vendored-dep-dirs))
                          (mapcat (fn [d] ["-L" d]) dirs)
                          ["-l" "ert"]
                          (mapcat (fn [f] ["-l" f]) files)
                          ["-f" "ert-run-tests-batch-and-exit"])))}

  test:all
  {:doc     "Clojure suite + elisp parity + nth arg-order + ERT suites."
   :depends [test parity lint:nth test:ert]}}}
