(require 'cl-lib)

(require 'json)

(require 'hive-mcp-cider-sessions)

(defcustom hive-mcp-cider-spawnwatch-directory nil
  "Root under which this daemon publishes its CIDER session state.\nnil derives it: $HIVE_EMACS_ATTENTION_DIR, else $XDG_RUNTIME_DIR/hive-emacs,\nelse hive-emacs-<uid> under `temporary-file-directory'. hive-emacs on the JVM\nderives the same root, so change both or neither."
  :group 'hive-mcp-cider
  :type '(choice (const :tag "Derived" nil) directory))

(defcustom hive-mcp-cider-spawnwatch-poll-interval 1.0
  "Seconds between registry publications."
  :group 'hive-mcp-cider
  :type 'number)

(defvar hive-mcp-cider-spawnwatch--root nil
  "Root hive-emacs handed us, or nil to derive it.")

(defvar hive-mcp-cider-spawnwatch--timer nil
  "Repeating timer that refreshes the published registry.")

(defvar hive-mcp-cider-spawnwatch--last nil
  "Sessions as last published, so an unchanged registry is not rewritten.")

(defvar hive-mcp-cider-spawnwatch--last-error nil
  "Message of the last timer error, for diagnostics.")

(defun hive-mcp-cider-spawnwatch--derived-root ()
  "Root derived from customization and environment, for a manual `enable'."
  (or hive-mcp-cider-spawnwatch-directory (let* ((override (getenv "HIVE_EMACS_ATTENTION_DIR")))
    (when (and override (not (string-empty-p override)))
    override)) (let* ((runtime (getenv "XDG_RUNTIME_DIR")))
    (when (and runtime (file-directory-p runtime))
    (expand-file-name "hive-emacs" runtime))) (expand-file-name (format "hive-emacs-%d" (user-uid)) temporary-file-directory)))

(defun hive-mcp-cider-spawnwatch-root-directory ()
  "Directory under which every daemon publishes its session state."
  (or hive-mcp-cider-spawnwatch--root (hive-mcp-cider-spawnwatch--derived-root)))

(defun hive-mcp-cider-spawnwatch-daemon-directory ()
  "This daemon's directory: the root joined with `server-name'."
  (expand-file-name (or (bound-and-true-p server-name) "server") (hive-mcp-cider-spawnwatch-root-directory)))

(defun hive-mcp-cider-spawnwatch-state-file ()
  "Path of the published registry."
  (expand-file-name "cider-spawns.json" (hive-mcp-cider-spawnwatch-daemon-directory)))

(defun hive-mcp-cider-spawnwatch-unsettled-p (status)
  "Return non-nil when STATUS means a spawn has not reached its outcome.\nSTATUS is the string `hive-mcp-cider-sessions-list-all' projects."
  (and (member status '("starting" "connecting")) t))

(defun hive-mcp-cider-spawnwatch-any-unsettled-p (sessions)
  "Return non-nil when any of SESSIONS is still on its way to an outcome."
  (and (cl-some (lambda (session)
    (hive-mcp-cider-spawnwatch-unsettled-p (plist-get session :status))) sessions) t))

(defun hive-mcp-cider-spawnwatch-republish-p (sessions last)
  "Return non-nil when SESSIONS must be written although LAST was published.\nAn unsettled spawn is republished every tick so its heartbeat stays fresh;\notherwise only a change is worth a write."
  (or (hive-mcp-cider-spawnwatch-any-unsettled-p sessions) (not (equal sessions last))))

(defun hive-mcp-cider-spawnwatch--reconcile ()
  "Demote sessions whose `connected' claim is contradicted by reality.\nA no-op when the connection module is not loaded."
  (when (fboundp 'hive-mcp-cider-connection-reconcile-sessions)
    (ignore-errors (hive-mcp-cider-connection-reconcile-sessions))))

(defun hive-mcp-cider-spawnwatch--write-state (plist)
  "Atomically publish PLIST as JSON, in a directory only this user can read."
  (let* ((dir (hive-mcp-cider-spawnwatch-daemon-directory))
        (file (hive-mcp-cider-spawnwatch-state-file))
        (tmp (format "%s.tmp" file))
        (coding-system-for-write 'utf-8))
    (with-file-modes 448 (make-directory dir t) (with-temp-file tmp (insert (json-encode plist))))
    (rename-file tmp file t)))

(defun hive-mcp-cider-spawnwatch--clear-state ()
  "Remove the published registry, if any."
  (let* ((file (hive-mcp-cider-spawnwatch-state-file)))
    (when (file-exists-p file)
    (ignore-errors (delete-file file))))
  (setq hive-mcp-cider-spawnwatch--last nil))

(defun hive-mcp-cider-spawnwatch-publish ()
  "Publish the session registry when it changed or a spawn is unsettled.\nReturns the sessions considered."
  (let* ((sessions (hive-mcp-cider-sessions-list-all)))
    (when (hive-mcp-cider-spawnwatch-republish-p sessions hive-mcp-cider-spawnwatch--last)
    (setq hive-mcp-cider-spawnwatch--last sessions)
    (hive-mcp-cider-spawnwatch--write-state (list :server (or (bound-and-true-p server-name) "server") :pid (emacs-pid) :heartbeat (float-time) :sessions sessions)))
    sessions))

(defun hive-mcp-cider-spawnwatch--tick ()
  "Timer body: reconcile, then refresh the published registry. Never signals."
  (condition-case err
    (progn
  (hive-mcp-cider-spawnwatch--reconcile)
  (hive-mcp-cider-spawnwatch-publish))
  (error (setq hive-mcp-cider-spawnwatch--last-error (error-message-string err)))))

(defun hive-mcp-cider-spawnwatch-enabled-p ()
  "Non-nil when publishing is active."
  (and (timerp hive-mcp-cider-spawnwatch--timer) t))

(defun hive-mcp-cider-spawnwatch-enable (&optional root)
  "Start publishing the CIDER session registry under ROOT. Idempotent.\nhive-emacs passes the root it reads from, so both sides agree by construction;\na nil ROOT falls back to `hive-mcp-cider-spawnwatch-directory' and the\nenvironment."
  (setq hive-mcp-cider-spawnwatch--root (if (and (stringp root) (not (string-empty-p root))) (expand-file-name root) (hive-mcp-cider-spawnwatch--derived-root)))
  (setq hive-mcp-cider-spawnwatch--last nil)
  (add-hook 'kill-emacs-hook #'hive-mcp-cider-spawnwatch--clear-state)
  (when (timerp hive-mcp-cider-spawnwatch--timer)
    (cancel-timer hive-mcp-cider-spawnwatch--timer))
  (setq hive-mcp-cider-spawnwatch--timer (run-at-time hive-mcp-cider-spawnwatch-poll-interval hive-mcp-cider-spawnwatch-poll-interval #'hive-mcp-cider-spawnwatch--tick))
  (hive-mcp-cider-spawnwatch--tick)
  t)

(defun hive-mcp-cider-spawnwatch-disable ()
  "Stop publishing and remove the state file. Idempotent."
  (remove-hook 'kill-emacs-hook #'hive-mcp-cider-spawnwatch--clear-state)
  (when (timerp hive-mcp-cider-spawnwatch--timer)
    (cancel-timer hive-mcp-cider-spawnwatch--timer))
  (setq hive-mcp-cider-spawnwatch--timer nil)
  (hive-mcp-cider-spawnwatch--clear-state)
  t)

(defun hive-mcp-cider-spawnwatch-status ()
  "JSON status for diagnostics over emacsclient (when emacsclient works)."
  (json-encode (list :enabled (if (hive-mcp-cider-spawnwatch-enabled-p) t :json-false) :file (hive-mcp-cider-spawnwatch-state-file) :sessions (hive-mcp-cider-sessions-count-sessions) :last_error hive-mcp-cider-spawnwatch--last-error)))

(provide 'hive-mcp-cider-spawnwatch)
