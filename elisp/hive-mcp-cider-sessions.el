(defun hive-mcp-cider-sessions-register (name props)
  "Register a session NAME with PROPS plist in the registry.\nSignals error if NAME already exists."
  (unless (and name (stringp name))
    (error "Invalid session name: %S" name))
  (when (hive-mcp-cider-sessions-registry-has-name-p name)
    (error "Session '%s' already exists" name))
  (puthash name props hive-mcp-cider-sessions--registry)
  props)

(defun hive-mcp-cider-sessions-unregister (name)
  "Remove session NAME from the registry and release its port claim.\nReturns the removed plist or nil."
  (let* ((session (gethash name hive-mcp-cider-sessions--registry)))
    (remhash name hive-mcp-cider-sessions--registry)
    (hive-mcp-cider-sessions-release-port (plist-get session :port) name)
    session))

(defun hive-mcp-cider-sessions-lookup (name)
  "Get session plist for NAME, or nil if not found."
  (gethash name hive-mcp-cider-sessions--registry))

(defun hive-mcp-cider-sessions-get-prop (name key)
  "Get property KEY from session NAME. Returns nil if session or key not found."
  (plist-get (gethash name hive-mcp-cider-sessions--registry) key))

(defun hive-mcp-cider-sessions-update-prop (name key value)
  "Set property KEY to VALUE in session NAME.\nSignals error if session not found."
  (let* ((session (gethash name hive-mcp-cider-sessions--registry)))
    (unless session
    (error "Session '%s' not found" name))
    (puthash name (plist-put session key value) hive-mcp-cider-sessions--registry)
    value))

(defun hive-mcp-cider-sessions-update-props (name &rest kvs)
  "Set multiple properties in session NAME from key-value pairs.\nSignals error if session not found."
  (let* ((session (gethash name hive-mcp-cider-sessions--registry)))
    (unless session
    (error "Session '%s' not found" name))
    (while kvs
    (setq session (plist-put session (car kvs) (cadr kvs)))
    (setq kvs (cddr kvs)))
    (puthash name session hive-mcp-cider-sessions--registry)
    session))

(defun hive-mcp-cider-sessions-exists-p (name)
  "Return non-nil if session NAME exists."
  (hive-mcp-cider-sessions-registry-has-name-p name))

(defun hive-mcp-cider-sessions-enum-label (value fallback)
  "Return FALLBACK for nil, symbol name for symbols, or VALUE unchanged."
  (cond
  ((null value) fallback)
  ((symbolp value) (symbol-name value))
  (t value)))

(defun hive-mcp-cider-sessions-list-all ()
  "Return a vector of session info plists for JSON encoding.\nEach entry contains :name, :port, :repl-type, :status, :reason, :agent-id,\n:project-dir, :cider-buffer. :project-dir lets callers match a session to\nits project for scoped reuse; :reason carries why a failed session failed."
  (let* ((sessions '()))
    (maphash (lambda (name props)
    (when (stringp name)
    (let* ((status (plist-get props :status))
        (rtype (plist-get props :repl-type)))
    (push (list :name name :port (plist-get props :port) :repl-type (hive-mcp-cider-sessions-enum-label rtype "clj") :status (hive-mcp-cider-sessions-enum-label status "unknown") :reason (plist-get props :reason) :agent-id (plist-get props :agent-id) :project-dir (plist-get props :project-dir) :cider-buffer (plist-get props :cider-buffer)) sessions)))) hive-mcp-cider-sessions--registry)
    (vconcat sessions)))

(defun hive-mcp-cider-sessions-find-by-status (status)
  "Find first session name with STATUS (symbol). Returns name string or nil."
  (let* ((result nil))
    (maphash (lambda (name props)
    (when (and (stringp name) (not result) (eq (plist-get props :status) status))
    (setq result name))) hive-mcp-cider-sessions--registry)
    result))

(defun hive-mcp-cider-sessions-find-by-buffer (buffer-name)
  "Find the session that owns BUFFER-NAME as its :cider-buffer.\nReturns the session name string, or nil when no session claims BUFFER-NAME."
  (let* ((result nil))
    (maphash (lambda (name props)
    (when (and (stringp name) (not result) (equal (plist-get props :cider-buffer) buffer-name))
    (setq result name))) hive-mcp-cider-sessions--registry)
    result))

(defun hive-mcp-cider-sessions-stale-p (status alive-p)
  "Return non-nil when a session declaring STATUS with liveness ALIVE-P is lying.\nA session is stale exactly when it claims 'connected while its REPL is not live.\nPure decision function — no registry or CIDER access."
  (and (eq status 'connected) (not alive-p)))

(defun hive-mcp-cider-sessions-reconcile (alive-fn)
  "Demote every session whose 'connected claim is contradicted by reality.\nALIVE-FN is a predicate (NAME) -> non-nil when that session's REPL is live;\ninjecting it keeps this registry free of any CIDER dependency.\nReturns the list of names demoted to 'stale."
  (let* ((demoted '()))
    (maphash (lambda (name props)
    (when (and (stringp name) (hive-mcp-cider-sessions-stale-p (plist-get props :status) (funcall alive-fn name)))
    (push name demoted))) hive-mcp-cider-sessions--registry)
    (dolist (name demoted)
    (hive-mcp-cider-sessions-update-prop name :status 'stale))
    demoted))

(defun hive-mcp-cider-sessions-promotable-p (status alive-p)
  "Return non-nil when a session declaring STATUS with liveness ALIVE-P settled unrecorded.\nA session still claiming 'connecting while its REPL is live is connected. Pure."
  (and (eq status 'connecting) alive-p t))

(defun hive-mcp-cider-sessions-promote (alive-fn)
  "Promote every 'connecting session whose REPL is live to 'connected.\nALIVE-FN is a predicate (NAME) -> non-nil when that session's REPL is live and\nfully settled. Returns the list of promoted names."
  (let* ((promoted '()))
    (maphash (lambda (name props)
    (when (and (stringp name) (hive-mcp-cider-sessions-promotable-p (plist-get props :status) (funcall alive-fn name)))
    (push name promoted))) hive-mcp-cider-sessions--registry)
    (dolist (name promoted)
    (hive-mcp-cider-sessions-update-props name :status 'connected :reason nil))
    promoted))

(defun hive-mcp-cider-sessions-clear-all ()
  "Remove all sessions from registry, releasing every port claim they hold."
  (maphash (lambda (name props)
    (hive-mcp-cider-sessions-release-port (plist-get props :port) name)) hive-mcp-cider-sessions--registry)
  (clrhash hive-mcp-cider-sessions--registry))

(defun hive-mcp-cider-sessions-count-sessions ()
  "Return the number of registered sessions."
  (hash-table-count hive-mcp-cider-sessions--registry))

(defun hive-mcp-cider-sessions-names ()
  "Return list of all session names."
  (hash-table-keys hive-mcp-cider-sessions--registry))

(defun hive-mcp-cider-sessions-held-ports (&optional except-name)
  "Ports held by registered sessions (see `port-holding-p'), other than\nEXCEPT-NAME's."
  (let* ((ports '()))
    (maphash (lambda (name props)
    (when (and (not (equal name except-name)) (hive-mcp-cider-sessions-port-holding-p props))
    (push (plist-get props :port) ports))) hive-mcp-cider-sessions--registry)
    ports))

(defun hive-mcp-cider-sessions-find-available-port (port-check-fn &optional name)
  "Find next available port in the session range.\nPORT-CHECK-FN is a predicate (port) -> bool that returns t if port is in use.\nA port a registered session holds is skipped without probing. With NAME, the\nreturned port is also atomically claimed for session NAME (`claim-port'), so\nno other selection, in this Emacs or another, is handed it until released."
  (let* ((port hive-mcp-cider-sessions-port-base)
        (used-ports (hive-mcp-cider-sessions-held-ports)))
    (while (and (<= port hive-mcp-cider-sessions-port-max) (or (member port used-ports) (funcall port-check-fn port) (and name (not (hive-mcp-cider-sessions-claim-port port name)))))
    (setq port (+ port 1)))
    (if (<= port hive-mcp-cider-sessions-port-max) port (error "No available ports in range %d-%d" hive-mcp-cider-sessions-port-base hive-mcp-cider-sessions-port-max))))

(defun hive-mcp-cider-sessions-reserve-port (name port-check-fn &optional requested)
  "Select and claim a port for session NAME; return it.\nREQUESTED is used when no other registered session holds it, PORT-CHECK-FN\nfinds it free and the claim succeeds; otherwise, and with no REQUESTED, the\nnext free port of the range is claimed (`find-available-port'). The claim is\nreleased by `release-port', `unregister' or `clear-all'."
  (if (and (integerp requested) (not (member requested (hive-mcp-cider-sessions-held-ports name))) (not (funcall port-check-fn requested)) (hive-mcp-cider-sessions-claim-port requested name)) requested (hive-mcp-cider-sessions-find-available-port port-check-fn name)))

(defun hive-mcp-cider-sessions-make-session (port &rest kvs)
  "Create a session plist with PORT and optional KVS overrides.\nDefaults: :process nil, :buffer nil, :agent-id nil, :project-dir nil,\n:repl-type 'clj, :status 'starting, :cider-buffer nil, :timer nil."
  (let* ((session (list :port port :process nil :buffer nil :agent-id nil :project-dir nil :repl-type 'clj :status 'starting :cider-buffer nil :timer nil)))
    (while kvs
    (setq session (plist-put session (car kvs) (cadr kvs)))
    (setq kvs (cddr kvs)))
    session))

