  (add-hook 'minibuffer-exit-hook #'hive-mcp-attention--on-minibuffer-exit)
  (add-hook 'debugger-mode-hook #'hive-mcp-attention--on-debugger)
  (add-hook 'kill-emacs-hook #'hive-mcp-attention--clear-state)
  (dolist (reader hive-mcp-attention--event-readers)
    (advice-add reader :around #'hive-mcp-attention--around-event-read))
