(defun hive-mcp-attention-disable ()
  "Stop publishing and remove the state file. Idempotent."
  (remove-hook 'minibuffer-setup-hook #'hive-mcp-attention--on-minibuffer-setup)
  (remove-hook 'minibuffer-exit-hook #'hive-mcp-attention--on-minibuffer-exit)
  (remove-hook 'debugger-mode-hook #'hive-mcp-attention--on-debugger)
  (remove-hook 'kill-emacs-hook #'hive-mcp-attention--clear-state)
  (dolist (reader hive-mcp-attention--event-readers)
    (advice-remove reader #'hive-mcp-attention--around-event-read))
  (advice-remove 'read-passwd #'hive-mcp-attention--around-read-passwd)
  (when (timerp hive-mcp-attention--timer)
    (cancel-timer hive-mcp-attention--timer))
  (setq hive-mcp-attention--timer nil)
  (hive-mcp-attention--clear-state)
  t)

